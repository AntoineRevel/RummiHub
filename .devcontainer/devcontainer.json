{
  "name": "RummiHub (.NET Aspire)",
  "image": "mcr.microsoft.com/devcontainers/dotnet:10.0-noble",
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:3.1.0": {},
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "onCreateCommand": "curl -sSL https://aspire.dev/install.sh | bash && curl -fsSL https://claude.ai/install.sh | bash",
  "updateContentCommand": "dotnet restore",
  "postStartCommand": "dotnet dev-certs https --trust",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "ms-azuretools.vscode-containers",
        "anthropic.claude-code"
      ]
    }
  }
}