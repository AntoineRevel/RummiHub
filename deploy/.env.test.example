# Copier vers deploy/.env.test sur le clone de test. Ne jamais committer le fichier rempli.
#
#   cp .env.test.example .env.test
#   openssl rand -hex 32
#
# Clé différente de deploy/.env de la production : les deux piles ne partagent
# ni Redis ni ce secret.

# Secret partagé, identique sur le webfrontend et l'apiservice de TEST.
# Au moins 32 caractères, uniquement lettres et chiffres (hex conseillé).
# Pas de $, d'espace ni de guillemet : Compose interpole le fichier.
SOLVER_API_KEY=

# Exigés par l'interpolation du compose de base (le service caddy y est décrit,
# même s'il ne démarre pas). Le nom public test.rummisolve.com est servi par
# le Caddy de production, pas par cette pile.
DOMAIN=rummisolve.com

# Inutilisé ici (pas de Caddy). Requis quand même par l'interpolation.
ACME_EMAIL=admin@rummisolve.com

# Inutilisée ici (pas de tableau de bord, rien n'est exporté). Requise quand même par
# l'interpolation. Une valeur quelconque, par exemple openssl rand -hex 32.
OTLP_API_KEY=

# Inutilisés ici (Umami et Caddy ne tournent que dans la production). Requis quand même
# par l'interpolation : une valeur quelconque.
UMAMI_DB_PASSWORD=inutilise
UMAMI_APP_SECRET=inutilise
ADMIN_PASSWORD_HASH=inutilise
