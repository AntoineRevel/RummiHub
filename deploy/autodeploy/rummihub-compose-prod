#!/bin/sh
# Build et redémarrage de la pile de production. Appelé par
# rummihub-deploy.service après la mise à jour du dépôt.
#
# Le verrou /run/rummihub/compose.lock est partagé avec le déploiement de test :
# deux builds .NET en parallèle sur ce VPS peuvent vider la mémoire et faire
# tuer un conteneur de prod. Si le verrou est tenu, on attend, puis on échoue
# sans lancer Compose (l'ancienne pile reste en place).
#
# Le réseau rummihub-edge est créé avant Compose : sinon `up` échoue tout de
# suite, là aussi sans recréer les conteneurs.

set -eu

cd /home/ubuntu/apps/RummiHub/deploy

/usr/local/bin/rummihub-ensure-edge-network

if [ ! -d /run/rummihub ]; then
  echo "Répertoire /run/rummihub absent. Installer deploy/autodeploy/rummihub.tmpfiles (deploy/README.md)." >&2
  exit 1
fi

exec 9>/run/rummihub/compose.lock
if ! flock -w 1500 9; then
  echo "Un déploiement (prod ou test) tient le verrou Docker depuis plus de 25 min." >&2
  exit 1
fi

docker compose up -d --build --remove-orphans --wait --wait-timeout 300
docker image prune -f
