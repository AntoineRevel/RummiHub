#!/bin/sh
# Corps de rummihub-deploy-test@.service. L'argument est le SHA complet du commit
# (%i), revalidé ici. Détache le clone de test sur ce commit, puis reconstruit la
# pile rummihub-test.
#
# Un commit qui modifie deploy/ est refusé. La pile est lancée avec les
# fichiers Compose de la branche : un Compose modifié (volume /, docker.sock,
# privileged…) donnerait root sur le VPS de production. Le code applicatif et le
# Dockerfile, eux, restent dans les conteneurs.
#
# Le clone est jetable, sauf deploy/.env et deploy/.env.test (gitignorés, donc
# gardés par git clean sans -x). Pas de Caddy ici : le routage est dans le Caddy de prod.
# La pile s'arrête seule deux heures plus tard (rummihub-test-autostop.timer) ; un
# nouveau déploiement la relance.

set -eu

root=/home/ubuntu/apps/RummiHub-test
sha=${1-}

case "$sha" in
  *[!0-9a-f]*) sha= ;;
esac
if [ "${#sha}" -ne 40 ]; then
  echo "Instance refusée : SHA complet attendu." >&2
  exit 1
fi

if [ ! -f "$root/deploy/.env.test" ]; then
  echo "Fichier $root/deploy/.env.test manquant (deploy/README.md, « Site de test »)." >&2
  exit 1
fi

/usr/local/bin/rummihub-ensure-edge-network

if [ ! -d /run/rummihub ]; then
  echo "Répertoire /run/rummihub absent. Installer deploy/autodeploy/rummihub.tmpfiles." >&2
  exit 1
fi

exec 9>/run/rummihub/compose.lock
if ! flock -w 1500 9; then
  echo "Un déploiement (prod ou test) tient le verrou Docker depuis plus de 25 min." >&2
  exit 1
fi

cd "$root"
# GitHub sert un commit par son SHA. Échoue s'il n'existe pas.
git fetch origin master "$sha"

# Trois points : seulement ce que le commit a changé depuis qu'il a quitté master. Une
# branche partie d'un master plus ancien garde le deploy/ de ce master-là.
if ! git diff --quiet "origin/master...$sha" -- deploy; then
  echo "Refus : ce commit modifie deploy/ par rapport à master." >&2
  git diff --stat "origin/master...$sha" -- deploy >&2 || true
  exit 1
fi

git checkout --force --detach "$sha"
git clean -ffd
echo "rummihub-deploy-test: $(git log -1 --format='%h %s')"

# Bandeau du site de test (TestSite__Commit, docker-compose.test.yml) : la branche
# dont ce commit est la pointe (une autre que master si possible), puis le commit.
# Affichage seulement ; sans branche trouvée, le commit seul.
branch=$(git ls-remote --heads origin | awk -v sha="$sha" '
  $1 == sha { b = substr($2, 12); if (b != "master") { print b; found = 1; exit } m = b }
  END { if (!found && m != "") print m }')
TEST_COMMIT=$(git log -1 --format='%h %s')
if [ -n "$branch" ]; then
  TEST_COMMIT="$branch · $TEST_COMMIT"
fi
export TEST_COMMIT

# Point de départ des deux heures avant l'arrêt automatique (rummihub-test-autostop).
touch /run/rummihub/test-deployed

docker compose \
  --project-directory "$root/deploy" \
  --project-name rummihub-test \
  --env-file "$root/deploy/.env.test" \
  -f "$root/deploy/docker-compose.yml" \
  -f "$root/deploy/docker-compose.test.yml" \
  up -d --build --remove-orphans --wait --wait-timeout 300

docker image prune -f
