#!/bin/sh
# Sort 0 si l'argument est un nom de branche déployable sur le site de test.
# Règles : 1 à 100 caractères parmi lettres, chiffres, « . », « _ », « - », « / » ;
# pas de « .. » ; pas de tiret initial (sinon git pourrait y voir une option).
# Le test porte sur toute la chaîne, pas ligne par ligne : un saut de ligne est refusé.

set -u

branch=${1-}

if [ -z "$branch" ] || [ "${#branch}" -gt 100 ]; then
  echo "Branche refusée : de 1 à 100 caractères." >&2
  exit 1
fi

case "$branch" in
  -*)
    echo "Branche refusée : elle ne doit pas commencer par « - »." >&2
    exit 1
    ;;
  *..*)
    echo "Branche refusée : « .. » est interdit." >&2
    exit 1
    ;;
  *[!A-Za-z0-9._/-]*)
    echo "Branche refusée : caractère interdit." >&2
    exit 1
    ;;
esac

exit 0
