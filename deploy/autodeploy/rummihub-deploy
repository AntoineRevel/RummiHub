#!/bin/sh
# Déploie origin/master et affiche le journal jusqu'à la fin ; sort en erreur si le
# déploiement échoue. Commande forcée de la clé SSH de GitHub Actions, se lance aussi à
# la main sur le VPS. Le travail tourne dans rummihub-deploy.service : une connexion
# coupée ne l'interrompt pas.

journalctl -u rummihub-deploy.service -f -n 0 -o cat &
follow=$!
sleep 1

sudo -n systemctl start rummihub-deploy.service
status=$?

sleep 1
kill "$follow"
exit "$status"
