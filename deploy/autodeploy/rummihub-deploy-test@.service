# Met le site de test sur un commit (clone séparé, projet rummihub-test). L'instance
# est le SHA complet. Démarré par rummihub-deploy-test (SSH depuis GitHub Actions, ou
# à la main). Deux instances peuvent être « actives » ; le verrou dans
# rummihub-deploy-test-run les fait s'exécuter l'une après l'autre.
# Installation : deploy/README.md, « Site de test ».

[Unit]
Description=RummiHub : déploiement du site de test (%i)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/apps/RummiHub-test
Environment="GIT_SSH_COMMAND=ssh -o ConnectTimeout=20 -o BatchMode=yes"
Environment=GIT_TERMINAL_PROMPT=0
ExecStart=/usr/local/bin/rummihub-deploy-test-run %i
# Laisse le temps d'attendre le verrou partagé avec la prod, puis de builder.
TimeoutStartSec=70min
SyslogIdentifier=rummihub-deploy-test
