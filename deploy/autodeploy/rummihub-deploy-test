#!/bin/sh
# Déploie origin/test sur le site de test et affiche le journal jusqu'à la fin ; sort en
# erreur si le déploiement échoue. Appelé par la commande forcée SSH (« deploy-test »),
# se lance aussi à la main sur le VPS. Le travail tourne dans rummihub-deploy-test.service :
# une connexion coupée ne l'interrompt pas.

journalctl -u rummihub-deploy-test.service -f -n 0 -o cat &
follow=$!
sleep 1

sudo -n systemctl start rummihub-deploy-test.service
status=$?

sleep 1
kill "$follow" 2>/dev/null || true
exit "$status"
