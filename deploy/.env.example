# Copier vers deploy/.env. Ne jamais committer le fichier rempli.
#
#   cp .env.example .env
#   openssl rand -hex 32

# Secret partagé, identique sur webfrontend et apiservice (en-tête X-Solver-Key).
# Au moins 32 caractères, uniquement lettres et chiffres (hex conseillé).
# Pas de $, d'espace ni de guillemet : Compose interpole le fichier.
SOLVER_API_KEY=

# Apex public. www.$DOMAIN redirige vers https://$DOMAIN.
DOMAIN=rummisolve.com

# Compte Let's Encrypt (avis d'expiration). Ignoré par l'essai local (Caddyfile.local).
ACME_EMAIL=admin@rummisolve.com

# Clé de l'API de télémétrie du tableau de bord Aspire (en-tête x-api-key).
# Facultative : vide, l'API répond 401 et seule l'interface (jeton) reste ouverte.
# openssl rand -hex 32, mêmes règles que SOLVER_API_KEY.
DASHBOARD_API_KEY=

# Clé que le tableau de bord exige pour recevoir la télémétrie des services (OTLP).
# Obligatoire : vide, Compose refuse de démarrer. openssl rand -hex 32, autre valeur
# que les clés ci-dessus.
OTLP_API_KEY=

# Secret partagé avec deploy/.env.test du site de test (même valeur des deux côtés).
# Le site de test s'en sert pour lire et ajouter une graine. Il n'y a pas de route
# pour supprimer ou remplacer la liste. openssl rand -hex 32.
SEED_CATALOG_KEY=
