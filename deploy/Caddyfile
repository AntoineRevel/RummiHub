{
	email {$ACME_EMAIL}
	admin off
}

# En-têtes de sécurité, posés sur chaque site. « defer » : appliqués après la réponse
# du webfrontend, pour remplacer son HSTS (30 j) et retirer son Server: Kestrel.
# includeSubDomains : www et test sont aussi en HTTPS seulement.
(securite) {
	header {
		defer
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
		-Via
	}
}

# Statistiques (Umami, https://stats.<DOMAIN>). Le script de suivi et son envoi passent
# par le site lui-même, sous /stats/ : moins bloqués qu'un domaine de statistiques, et
# rien d'autre d'Umami (connexion, API) n'est servi ici. Nom du conteneur, pas du service,
# comme pour le webfrontend (voir plus bas).
(statistiques) {
	@umami path /stats/script.js /stats/api/send
	handle @umami {
		uri strip_prefix /stats
		reverse_proxy rummihub-umami-1:3000 {
			header_up X-Forwarded-For {remote_host}
		}
	}
}

# Pages d'administration (/admin/…, parties en cours) : mot de passe demandé par Caddy.
# ADMIN_PASSWORD_HASH vient de `caddy hash-password` (deploy/README.md).
(admin) {
	basic_auth /admin* {
		{$ADMIN_USER} {$ADMIN_PASSWORD_HASH}
	}
}

{$DOMAIN} {
	import securite
	import admin
	import statistiques
	encode gzip
	# Nom du conteneur, pas « webfrontend » : sur le réseau rummihub-edge, Docker donne
	# aussi ce nom de service au webfrontend du site de test, et Caddy y envoyait alors
	# le site public. rummihub-webfrontend-1 n'existe que dans le projet de production.
	reverse_proxy rummihub-webfrontend-1:8080 {
		# Blazor Server / SignalR : pas de tampon, en-têtes de proxy explicites.
		flush_interval -1
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}
}

www.{$DOMAIN} {
	import securite
	redir https://{$DOMAIN}{uri} permanent
}

# Site de test. Le webfrontend vit dans l'autre projet Compose (rummihub-test),
# sur le réseau rummihub-edge, sous l'alias webfrontend-test. La résolution est
# refaite toutes les 5 s : un déploiement de test ne recharge pas ce Caddy, et
# une pile de test arrêtée ne casse pas les autres sites (502 sur ce nom seul).
test.{$DOMAIN} {
	import securite
	import admin
	import statistiques
	encode gzip
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy {
		dynamic a webfrontend-test 8080 {
			refresh 5s
			resolvers 127.0.0.11
			versions ipv4
			dial_timeout 3s
		}
		flush_interval -1
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}
	handle_errors {
		header X-Robots-Tag "noindex, nofollow"
		respond "Site de test indisponible." 502
	}
}

# Interface d'Umami (connexion par compte, liens de partage en lecture seule).
stats.{$DOMAIN} {
	import securite
	encode gzip
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy rummihub-umami-1:3000 {
		header_up X-Forwarded-For {remote_host}
	}
}
