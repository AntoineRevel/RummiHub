{
	email {$ACME_EMAIL}
	admin off
}

{$DOMAIN} {
	encode gzip
	# Nom du conteneur, pas « webfrontend » : sur le réseau rummihub-edge, Docker donne
	# aussi ce nom de service au webfrontend du site de test, et Caddy y envoyait alors
	# le site public. rummihub-webfrontend-1 n'existe que dans le projet de production.
	reverse_proxy rummihub-webfrontend-1:8080 {
		# Blazor Server / SignalR : pas de tampon, en-têtes de proxy explicites.
		flush_interval -1
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# Site de test. Le webfrontend vit dans l'autre projet Compose (rummihub-test),
# sur le réseau rummihub-edge, sous l'alias webfrontend-test. La résolution est
# refaite toutes les 5 s : un déploiement de test ne recharge pas ce Caddy, et
# une pile de test arrêtée ne casse pas les autres sites (502 sur ce nom seul).
test.{$DOMAIN} {
	encode gzip
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy {
		dynamic a webfrontend-test 8080 {
			refresh 5s
			resolvers 127.0.0.11
			versions ipv4
			dial_timeout 3s
		}
		flush_interval -1
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}
	handle_errors {
		header X-Robots-Tag "noindex, nofollow"
		respond "Site de test indisponible." 502
	}
}
