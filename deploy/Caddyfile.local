{
	admin off
	local_certs
}

{$DOMAIN} {
	tls internal
	encode gzip
	reverse_proxy webfrontend:8080 {
		flush_interval -1
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}
}

www.{$DOMAIN} {
	tls internal
	redir https://{$DOMAIN}{uri} permanent
}
