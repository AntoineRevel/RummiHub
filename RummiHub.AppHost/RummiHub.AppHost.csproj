<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <UserSecretsId>1e08f647-4e32-440b-89eb-0083365166e0</UserSecretsId>
    </PropertyGroup>

    <!-- The services are registered by path in AppHost.cs (AddDotnetProject): no
         ProjectReference and no generated Projects.* types. Aspire builds them itself. -->
    <ItemGroup>
        <PackageReference Include="Aspire.Hosting.AppHost" Version="17.0.0" />
        <PackageReference Include="Aspire.Hosting.Dotnet" Version="17.0.0" />
        <PackageReference Include="Aspire.Hosting.Redis" Version="17.0.0" />
    </ItemGroup>

</Project>
