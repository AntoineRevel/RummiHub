meta {
  name: Récupérer le résultat
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/solve/{{contentHash}}
  body: none
  auth: none
}

tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Réponse cohérente", function() {
    const body = res.body;
    // Si en attente
    if (body.status === "pending") {
      expect(body.contentHash).to.be.a("string");
    }
    // Si complété
    if (body.found !== undefined) {
      expect(body.found).to.be.a("boolean");
      expect(body.score).to.be.a("number");
    }
  });
}
