meta {
  name: Scenario 2 - Red run result
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/solve/{{contentHash}}
  body: none
  auth: none
}

tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Solution found (score = 25)", function() {
    if (res.body.found !== undefined) {
      expect(res.body.found).to.equal(true);
      expect(res.body.score).to.equal(25);
      expect(res.body.tilesToPlay).to.have.lengthOf(5);
    }
  });
}
