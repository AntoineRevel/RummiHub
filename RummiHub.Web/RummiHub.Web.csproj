<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\RummiHub.ServiceDefaults\RummiHub.ServiceDefaults.csproj" />
        <ProjectReference Include="..\RummiHub.Core\RummiHub.Core.csproj" />
        <!-- The /bench page drives the in-memory benchmark library (no Redis/SignalR/Aspire). -->
        <ProjectReference Include="..\RummiHub.SolverBench\RummiHub.SolverBench.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Aspire.StackExchange.Redis" Version="13.6.3" />
        <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="*" />
    </ItemGroup>

    <!-- SolverBench references the worker, whose appsettings.json would otherwise collide
         with this project's file at publish time (NETSDK1152). Aspire runs the projects
         separately, so the clash only shows up in the container publish. -->
    <Target Name="DropReferencedWorkerAppSettings" BeforeTargets="_HandleFileConflictsForPublish">
        <ItemGroup>
            <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                Condition="'%(RelativePath)' == 'appsettings.json' and $([System.String]::Copy('%(FullPath)').Contains('RummiHub.Solver.Worker'))" />
        </ItemGroup>
    </Target>

</Project>
