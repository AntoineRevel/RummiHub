@using RummiHub.Core.Models
<div class="tile @(Tile.IsJoker ? "joker" : "") @(ShouldHighlight ? "highlight" : "")"
     data-tile-type="@(Tile.IsJoker ? "joker" : $"{Tile.Color}-{Tile.Value}")">
    <div class="tile-number" style="color:@(Tile.IsJoker ? "purple" : GetColor(Tile.Color))">
        <b>@(Tile.IsJoker ? "J" : Tile.Value.ToString())</b>
    </div>
</div>


@code {
    [Parameter] public required Tile Tile { get; set; }
    [Parameter] public bool ShouldHighlight { get; set; }
    [Parameter] public int? TileIndex { get; set; }
    [Parameter] public HashSet<int>? HighlightIndices { get; set; }

    protected override void OnParametersSet()
    {
        if (TileIndex.HasValue && HighlightIndices != null)
        {
            ShouldHighlight = HighlightIndices.Contains(TileIndex.Value);
        }
    }

    private static string GetColor(TileColor color)
    {
        return color switch
        {
            TileColor.Blue => "blue",
            TileColor.Red => "red",
            TileColor.Mango => "orange",
            TileColor.Black => "black",
            _ => "gray"
        };
    }

}

<style>
    .tile {
        position: relative;
        display: inline-block;
        width: 50px;
        height: 70px;
        background-color: #dcdbdb;
        border: 2px solid #CCCCCC;
        border-radius: 10px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }

    .tile-number {
        position: absolute;
        top: 5px;
        width: 100%;
        text-align: center;
        font-size: 24px;
        font-weight: bold;
    }

    .tile.joker {
        background-color: #FFD700;
    }

    .tile.highlight {
        border-color: #ffb300;
        box-shadow: 0 0 0 3px rgba(255, 179, 0, 0.3), 0 4px 10px rgba(255, 179, 0, 0.25);
        animation: tile-played-glow 1.8s ease-out;
    }

    @@keyframes tile-played-glow {
        0% { box-shadow: 0 0 0 7px rgba(255, 179, 0, 0.55), 0 4px 14px rgba(255, 179, 0, 0.45); }
        100% { box-shadow: 0 0 0 3px rgba(255, 179, 0, 0.3), 0 4px 10px rgba(255, 179, 0, 0.25); }
    }

    .tile:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 10px rgba(0, 0, 0, 0.15);
        transition: transform 0.2s, box-shadow 0.2s;
    }
</style>
