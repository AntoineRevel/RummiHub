@using RummiHub.Core.Models
<div class="solution-container">
    @foreach (var setWithIndex in GetRunsWithIndices())
    {
        <ValidSetComponent ValidSet="setWithIndex.Set" StartIndex="setWithIndex.StartIndex"
                           HighlightIndices="HighlightIndices"
                           IsModified="IsSetModified(setWithIndex.SetOrdinal)"/>
    }
</div>
<div class="solution-container">
    @foreach (var setWithIndex in GetGroupsWithIndices())
    {
        <ValidSetComponent ValidSet="setWithIndex.Set" StartIndex="setWithIndex.StartIndex"
                           HighlightIndices="HighlightIndices"
                           IsModified="IsSetModified(setWithIndex.SetOrdinal)"/>
    }
</div>

@code {
    [Parameter] public required Solution Solution { get; set; }

    /// <summary>
    /// Reading-order indices (runs then groups) of the tiles to highlight. Computed
    /// server-side (see BoardPacing.EnteredIndices) so the freshly-played copy of a tile
    /// lights up, never an identical twin already resting on the board.
    /// </summary>
    [Parameter] public HashSet<int>? HighlightIndices { get; set; }

    /// <summary>
    /// Reading-order indices of sets the move changed (see BoardPacing.ModifiedSetIndices).
    /// </summary>
    [Parameter] public HashSet<int>? ModifiedSetIndices { get; set; }

    private bool IsSetModified(int setOrdinal) =>
        ModifiedSetIndices?.Contains(setOrdinal) == true;

    private List<(ValidSet Set, int StartIndex, int SetOrdinal)> GetRunsWithIndices()
    {
        var result = new List<(ValidSet, int, int)>();
        var currentIndex = 0;
        var ordinal = 0;

        foreach (var set in Solution.Runs)
        {
            result.Add((set, currentIndex, ordinal));
            currentIndex += set.Tiles.Length;
            ordinal++;
        }

        return result;
    }

    private List<(ValidSet Set, int StartIndex, int SetOrdinal)> GetGroupsWithIndices()
    {
        var result = new List<(ValidSet, int, int)>();
        var currentIndex = Solution.Runs.Sum(r => r.Tiles.Length);
        var ordinal = Solution.Runs.Count;

        foreach (var set in Solution.Groups)
        {
            result.Add((set, currentIndex, ordinal));
            currentIndex += set.Tiles.Length;
            ordinal++;
        }

        return result;
    }
}

<style>
    .solution-container {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-start;
    }

    /* The bottom margin is the lane a lifted tile waits in while the board makes room
       (LIFT in tile-animations.js, plus its slight scale-up): it must clear the row above,
       so a lifted tile never covers another. */
    .solution-container > * {
        flex: 0 0 auto;
        margin-right: 16px;
        margin-bottom: 36px;
    }
</style>
