@using RummiHub.Core.Models
<div class="solution-container">
    @foreach (var setWithIndex in GetSetsWithIndices())
    {
        <ValidSetComponent ValidSet="setWithIndex.Set" StartIndex="setWithIndex.StartIndex"
                           HighlightIndices="HighlightIndices"/>
    }
</div>

@code {
    [Parameter] public required Solution Solution { get; set; }

    /// <summary>
    /// Reading-order indices of the tiles to highlight. Computed server-side (see
    /// BoardPacing.EnteredIndices) so the freshly-played copy of a tile lights up, never an
    /// identical twin already resting on the board.
    /// </summary>
    [Parameter] public HashSet<int>? HighlightIndices { get; set; }

    private List<(ValidSet Set, int StartIndex)> GetSetsWithIndices()
    {
        var result = new List<(ValidSet, int)>();
        var currentIndex = 0;

        foreach (var set in Solution.Sets)
        {
            result.Add((set, currentIndex));
            currentIndex += set.Tiles.Length;
        }

        return result;
    }
}

<style>
    .solution-container {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-start;
    }

    /* The bottom margin is the lane a lifted or hovering tile rests in during a move
       (LIFT in tile-animations.js, plus its slight scale-up): it must clear the row above,
       so a tile at rest never covers another. */
    .solution-container > * {
        flex: 0 0 auto;
        margin-right: 10px;
        margin-bottom: 36px;
    }
</style>
