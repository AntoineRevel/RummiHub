@using Microsoft.Extensions.Options
@using RummiHub.Web.Services
@inject IOptions<UmamiOptions> Umami
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <base href="/"/>
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]"/>
    <link rel="stylesheet" href="@Assets["app.css"]"/>
    <link rel="stylesheet" href="@Assets["RummiHub.Web.styles.css"]"/>
    <ImportMap/>
    <link rel="icon" type="image/png" href="favicon.png"/>
    <HeadOutlet/>
</head>

<body>
<Routes/>
<script src="@Assets["_framework/blazor.web.js"]"></script>
<script src="@Assets["js/stats.js"]"></script>
@if (_umamiWebsite is not null)
{
    @* Served by Caddy from Umami (deploy/Caddyfile). The URL is sent without its query and
       fragment: the game link carries the player name and the seat secret (#seat=). *@
    <script defer src="/stats/script.js" data-website-id="@_umamiWebsite"
            data-exclude-search="true" data-exclude-hash="true"></script>
}
</body>

</html>
@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private string? _umamiWebsite;

    protected override void OnInitialized()
    {
        // The admin pages stay out of the visitor counts.
        if (HttpContext?.Request.Path.StartsWithSegments(AdminAccess.PathPrefix) == true)
            return;

        _umamiWebsite = Umami.Value.WebsiteFor(HttpContext?.Request.Host.Host);
    }
}
