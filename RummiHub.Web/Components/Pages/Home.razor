@page "/"
@rendermode InteractiveServer
@using RummiHub.Core.Contracts
@using RummiHub.Core.Models
@inject IHttpClientFactory HttpClientFactory
@inject RummiHub.Web.Services.SolveResultSubscriber SolveResultSubscriber
@implements IDisposable

<PageTitle>RummiHub</PageTitle>

<h1>RummiHub</h1>

<button @onclick="LaunchSolve"
        style="padding:8px 20px; font-size:1rem; cursor:pointer;">
    🚀 New task
</button>

@if (_tasks.Count > 0)
{
    <table style="margin-top:1rem; border-collapse:collapse; width:100%;">
        <thead>
            <tr style="border-bottom:2px solid #ccc; text-align:left;">
                <th style="padding:6px 12px;">#</th>
                <th style="padding:6px 12px;">Statut</th>
                <th style="padding:6px 12px;">Content Hash</th>
                <th style="padding:6px 12px;">Temps</th>
                <th style="padding:6px 12px;">Worker</th>
                <th style="padding:6px 12px;">Info</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var task in _tasks)
            {
                <tr style="border-bottom:1px solid #eee;">
                    <td style="padding:6px 12px;">@task.Index</td>
                    <td style="padding:6px 12px;">@task.Status</td>
                    <td style="padding:6px 12px; font-family:monospace; font-size:0.85rem;">@task.ContentHash</td>
                    <td style="padding:6px 12px;">
                        @if (task.Elapsed.HasValue)
                        {
                            @($"{task.Elapsed.Value.TotalMilliseconds:F0} ms")
                        }
                    </td>
                    <td style="padding:6px 12px; font-family:monospace; font-size:0.85rem;">@task.WorkerId</td>
                    <td style="padding:6px 12px; color:orange;">@task.Error</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private static readonly TileColor[] AllColors = Enum.GetValues<TileColor>();

    private readonly List<SolveTask> _tasks = [];
    private readonly CancellationTokenSource _disposeCts = new();
    private int _taskCounter;

    private async Task LaunchSolve()
    {
        var task = new SolveTask { Index = ++_taskCounter, Status = "⏳ Sending…" };
        _tasks.Insert(0, task);

        var requestId = $"req-{Guid.NewGuid().ToString()[..8]}";

        // Generate a random hand so each task has a different hash
        var hand = Enumerable.Range(0, Random.Shared.Next(3, 8))
            .Select(_ => new Tile(Random.Shared.Next(1, 14), AllColors[Random.Shared.Next(AllColors.Length)]))
            .ToList();

        var request = new SolveRequest
        {
            RequestId = requestId,
            Hand = hand,
            Board = new Solution { IsValid = true }
        };

        try
        {
            var client = HttpClientFactory.CreateClient("apiservice");
            var start = DateTime.UtcNow;

            var postResponse = await client.PostAsJsonAsync("/solve", request, _disposeCts.Token);
            postResponse.EnsureSuccessStatusCode();

            var accepted = await postResponse.Content.ReadFromJsonAsync<SolveAcceptedDto>(_disposeCts.Token);
            task.ContentHash = accepted?.ContentHash;

            if (task.ContentHash is null)
            {
                task.Status = "❌ Erreur";
                task.Error = "No content hash received";
                return;
            }

            task.Status = "⏳ Waiting for worker…";
            StateHasChanged();

            var result = await SolveResultSubscriber.WaitForResult(task.ContentHash, _disposeCts.Token);

            task.Elapsed = DateTime.UtcNow - start;
            task.WorkerId = result.WorkerId;
            task.Status = result.Found ? "✅ Solved" : "❌ No solution";
            task.Error = result.Error;
        }
        catch (OperationCanceledException)
        {
            task.Status = "🚫 Cancelled";
        }
        catch (Exception ex)
        {
            task.Status = "❌ Erreur";
            task.Error = ex.Message;
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        _disposeCts.Cancel();
        _disposeCts.Dispose();
    }

    private record SolveAcceptedDto(string? ContentHash, string? RequestId, string? Status);

    private class SolveTask
    {
        public int Index { get; init; }
        public string Status { get; set; } = "";
        public string? ContentHash { get; set; }
        public TimeSpan? Elapsed { get; set; }
        public string? WorkerId { get; set; }
        public string? Error { get; set; }
    }
}
