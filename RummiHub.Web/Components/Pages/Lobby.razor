@page "/lobby"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject Microsoft.AspNetCore.Hosting.Server.IServer Server
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Lobby — Rummikub</PageTitle>

<div class="lobby-container">
    <header>
        <h1>Rummikub</h1>
        <p>Create or join a game</p>
    </header>

    @if (!_isConnected)
    {
        <div class="connecting">
            <div class="spinner"></div>
            <span>Connecting to server...</span>
        </div>
    }
    else if (string.IsNullOrEmpty(_gameId))
    {
        <div class="lobby-form">
            <div class="form-group">
                <label for="playerName">Your name</label>
                <input id="playerName"
                       type="text"
                       class="form-control"
                       placeholder="Enter your name"
                       maxlength="20"
                       @bind="_playerName"
                       @bind:event="oninput"
                       @onkeydown="HandleKeyDown"
                       @ref="_nameInput" />
            </div>

            <div class="form-group">
                <label for="gameCode">Game code <span class="optional">(optional)</span></label>
                <input id="gameCode"
                       type="text"
                       class="form-control"
                       placeholder="Leave empty to create"
                       maxlength="50"
                       @bind="_joinGameId"
                       @bind:event="oninput"
                       @onkeydown="HandleKeyDown" />
            </div>

            @if (_availableGameIds.Count > 0 && string.IsNullOrWhiteSpace(_joinGameId))
            {
                <div class="form-group">
                    <label for="seedSelect">Distribution seed</label>
                    <select id="seedSelect" class="form-control" @bind="_selectedGameId">
                        <option value="">— Random —</option>
                        @foreach (var id in _availableGameIds)
                        {
                            <option value="@id">@id</option>
                        }
                    </select>
                </div>
            }

            <button class="btn-action @(string.IsNullOrWhiteSpace(_joinGameId) ? "btn-create" : "btn-join")"
                    @onclick="HandleAction"
                    disabled="@string.IsNullOrWhiteSpace(_playerName)">
                @if (string.IsNullOrWhiteSpace(_joinGameId))
                {
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                    </svg>
                    <span>Create a game</span>
                }
                else
                {
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
                        <polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/>
                    </svg>
                    <span>Join</span>
                }
            </button>
        </div>
    }
    else
    {
        <div class="waiting-room">
            <div class="game-info">
                <div class="info-row">
                    <span class="info-label">Game code</span>
                    <strong class="info-value">@_gameId</strong>
                </div>
                @if (!string.IsNullOrEmpty(_selectedGameId))
                {
                    <div class="info-row">
                        <span class="info-label">Seed</span>
                        <strong class="info-value seed-value">@_selectedGameId</strong>
                    </div>
                }
            </div>

            <button type="button" class="invite-link @(_inviteCopied ? "copied" : null)" @onclick="CopyInviteLink">
                @if (_inviteCopied)
                {
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="20 6 9 17 4 12"/>
                    </svg>
                    <span>Copied!</span>
                }
                else
                {
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                    </svg>
                    <span>Copy invite link</span>
                }
            </button>

            <div class="players-list">
                <h3>Players (@_players.Count)</h3>
                @foreach (var player in _players)
                {
                    <div class="player-row @(player == _playerName ? "me" : "")">
                        <span class="player-dot"></span>
                        <span>@player</span>
                        @if (player == _playerName)
                        {
                            <span class="you-badge">you</span>
                        }
                    </div>
                }
            </div>

            @if (_gameStarted)
            {
                <div class="game-started">
                    <p class="started-text">The game has started in a new tab.</p>
                    @* Real links, not a button calling window.open over the circuit: by the time
                       that call reaches the browser the tap no longer counts as a user gesture,
                       and Safari blocks the tab. A link is never blocked. *@
                    <a class="btn-start" href="@_gameUrl" target="_blank" rel="opener">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                            <polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/>
                        </svg>
                        Open the game
                    </a>
                    <p class="hint">Closing the game tab brings you back here.</p>
                </div>
            }
            else if (_isHost)
            {
                <button class="btn-add-ai" @onclick="AddAiPlayer" disabled="@(_players.Count >= 4)">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="4" y="8" width="16" height="11" rx="2"/><path d="M12 8V4"/><circle cx="12" cy="3" r="1"/>
                        <line x1="9" y1="13" x2="9" y2="15"/><line x1="15" y1="13" x2="15" y2="15"/>
                    </svg>
                    Add AI player
                </button>
                <button class="btn-start" @ref="_startButton" @onclick="StartGame" disabled="@(_players.Count < 2)">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"/>
                        <polygon points="10,8 16,12 10,16 10,8" fill="currentColor" stroke="none"/>
                    </svg>
                    Start game
                </button>
                @if (_players.Count < 2)
                {
                    <p class="hint">At least 2 players needed to start.</p>
                }
            }
            else
            {
                <p class="waiting-hint">
                    <span class="dot-pulse"></span>
                    Waiting for the host to start the game…
                </p>
            }
        </div>
    }

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="error-banner">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
            @_error
        </div>
    }
</div>

<style>
    .lobby-container {
        max-width: 480px;
        margin: 60px auto;
        padding: 40px;
        font-family: Arial, sans-serif;
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.10);
    }

    header {
        text-align: center;
        margin-bottom: 36px;
    }

    header h1 {
        font-size: 2.4rem;
        color: #3a3a3a;
        margin: 0 0 6px 0;
    }

    header p {
        color: #999;
        font-size: 1rem;
        margin: 0;
    }

    /* Connecting */
    .connecting {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        color: #777;
        padding: 20px 0;
    }

    /* Form */
    .lobby-form {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .form-group label {
        font-weight: 600;
        color: #3a3a3a;
        font-size: 0.95rem;
    }

    .optional {
        font-weight: 400;
        color: #aaa;
        font-size: 0.85rem;
    }

    .form-control {
        padding: 12px 15px;
        border: 2px solid #e0e0e0;
        border-radius: 10px;
        font-size: 1rem;
        transition: border-color 0.2s, box-shadow 0.2s;
        background: #fff;
        color: #3a3a3a;
    }

    .form-control:focus {
        outline: none;
        border-color: #2196f3;
        box-shadow: 0 0 0 3px rgba(33, 150, 243, 0.12);
    }

    /* Action button */
    .btn-action {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 14px 24px;
        font-size: 1.05rem;
        font-weight: 700;
        border: none;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.2s ease;
        margin-top: 4px;
        color: white;
    }

    .btn-create {
        background: linear-gradient(135deg, #2196f3, #1976d2);
        box-shadow: 0 4px 14px rgba(33, 150, 243, 0.3);
    }

    .btn-create:hover:not(:disabled) {
        background: linear-gradient(135deg, #1e88e5, #1565c0);
        transform: translateY(-2px);
        box-shadow: 0 6px 18px rgba(33, 150, 243, 0.4);
    }

    .btn-join {
        background: linear-gradient(135deg, #4caf50, #388e3c);
        box-shadow: 0 4px 14px rgba(76, 175, 80, 0.3);
    }

    .btn-join:hover:not(:disabled) {
        background: linear-gradient(135deg, #43a047, #2e7d32);
        transform: translateY(-2px);
        box-shadow: 0 6px 18px rgba(76, 175, 80, 0.4);
    }

    .btn-action:disabled {
        opacity: 0.45;
        cursor: not-allowed;
        transform: none;
        box-shadow: none;
    }

    .btn-action:active:not(:disabled) {
        transform: translateY(0);
    }

    /* Waiting room */
    .waiting-room {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .game-info {
        background: #f8f9fa;
        border: 2px solid #e9ecef;
        border-radius: 12px;
        padding: 16px 20px;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .info-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .info-label {
        font-size: 0.9rem;
        color: #888;
    }

    .info-value {
        font-size: 1rem;
        color: #3a3a3a;
        font-family: monospace;
        letter-spacing: 0.03em;
    }

    .seed-value {
        color: #1976d2;
    }

    .invite-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 16px;
        font-size: 0.88rem;
        font-family: inherit;
        color: #1976d2;
        background: #e3f2fd;
        border: 1px solid #90caf9;
        border-radius: 20px;
        cursor: pointer;
        align-self: flex-start;
        transition: background 0.2s, color 0.2s, border-color 0.2s;
    }

    .invite-link:hover {
        background: #bbdefb;
    }

    .invite-link.copied {
        color: #2e7d32;
        background: #e8f5e9;
        border-color: #a5d6a7;
    }

    .invite-link.copied:hover {
        background: #c8e6c9;
    }

    .players-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .players-list h3 {
        font-size: 1rem;
        color: #555;
        margin: 0 0 4px 0;
        font-weight: 600;
    }

    .player-row {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 14px;
        background: #f8f9fa;
        border: 2px solid #e9ecef;
        border-radius: 8px;
        font-size: 0.95rem;
        color: #3a3a3a;
    }

    .player-row.me {
        border-color: #2196f3;
        background: #e3f2fd;
    }

    .player-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #4caf50;
        flex-shrink: 0;
    }

    .you-badge {
        margin-left: auto;
        font-size: 0.75rem;
        color: #1976d2;
        font-weight: 600;
        background: #fff;
        border: 1px solid #90caf9;
        border-radius: 10px;
        padding: 2px 8px;
    }

    /* Start button */
    .btn-start {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 14px 24px;
        font-size: 1.05rem;
        font-weight: 700;
        color: white;
        background: linear-gradient(135deg, #ff9800, #f57c00);
        border: none;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.2s ease;
        box-shadow: 0 4px 14px rgba(255, 152, 0, 0.3);
    }

    .btn-start:hover:not(:disabled) {
        background: linear-gradient(135deg, #f57c00, #ef6c00);
        transform: translateY(-2px);
        box-shadow: 0 6px 18px rgba(255, 152, 0, 0.4);
    }

    .btn-start:disabled {
        opacity: 0.45;
        cursor: not-allowed;
        transform: none;
        box-shadow: none;
    }

    .btn-add-ai {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 12px 24px;
        font-size: 1rem;
        font-weight: 600;
        color: white;
        background: linear-gradient(135deg, #2196f3, #1976d2);
        border: none;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.2s ease;
        box-shadow: 0 4px 14px rgba(33, 150, 243, 0.3);
    }

    .btn-add-ai:hover:not(:disabled) {
        background: linear-gradient(135deg, #1976d2, #1565c0);
        transform: translateY(-2px);
        box-shadow: 0 6px 18px rgba(33, 150, 243, 0.4);
    }

    .btn-add-ai:disabled {
        opacity: 0.45;
        cursor: not-allowed;
        transform: none;
        box-shadow: none;
    }

    .hint {
        text-align: center;
        font-size: 0.85rem;
        color: #aaa;
        margin: -8px 0 0 0;
    }

    .game-started {
        text-align: center;
    }

    .game-started .btn-start {
        width: 100%;
        margin: 0 0 12px 0;
    }

    .game-started .hint {
        margin: 0;
    }

    .game-started a.btn-start {
        text-decoration: none;
    }

    .started-text {
        margin: 0 0 12px 0;
        color: #2e7d32;
        font-weight: 600;
    }

    .waiting-hint {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #888;
        font-size: 0.95rem;
    }

    /* Pulsing dot */
    .dot-pulse {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: #ff9800;
        flex-shrink: 0;
        animation: pulse 1.4s ease-in-out infinite;
    }

    @@keyframes pulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.4; transform: scale(0.8); }
    }

    /* Error */
    .error-banner {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 16px;
        padding: 12px 16px;
        background: #ffebee;
        border: 1px solid #ef9a9a;
        border-radius: 8px;
        color: #c62828;
        font-size: 0.9rem;
        font-weight: 500;
    }

    /* Spinner */
    @@keyframes spin {
        to { transform: rotate(360deg); }
    }

    .spinner {
        width: 20px;
        height: 20px;
        border: 3px solid #e0e0e0;
        border-top-color: #2196f3;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    @@media (max-width: 540px) {
        .lobby-container {
            margin: 20px;
            padding: 28px 20px;
        }
    }
</style>
