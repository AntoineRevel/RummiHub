@page "/admin/statistiques"
@using Microsoft.Extensions.Options
@using RummiHub.Web.Services
@inject IGameJournal Journal
@inject IOptions<UmamiOptions> Umami

@* Static page (no circuit). Caddy asks for the password (AdminAccess). Figures from the game
   journal the server writes (GameJournal.cs), not from the browser: a closed tab or a blocked
   tracker loses nothing. *@
<PageTitle>Statistiques</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex, nofollow"/>
</HeadContent>

<h1 class="h3">Statistiques des parties</h1>
<p class="text-muted small">
    @if (_report.Since is { } since)
    {
        <text>Journal tenu depuis le @Day(since) · </text>
    }
    heures UTC ·
    <a href="/admin/parties">Parties en cours</a>
    @if (!string.IsNullOrWhiteSpace(Umami.Value.DashboardUrl))
    {
        <text> · </text><a href="@Umami.Value.DashboardUrl">Visites (Umami)</a>
    }
</p>

<div class="card mb-3">
    <div class="card-body py-2 small">
        <div class="d-flex flex-wrap align-items-center gap-2">
            <span>
                <strong>Filtre :</strong>
                @if (IncludeMine)
                {
                    <text>tout le monde, moi compris · <a href="/admin/statistiques">sans mes parties</a></text>
                }
                else
                {
                    <text>sans mes parties · <a href="/admin/statistiques?tout=1">moi compris</a></text>
                }
            </span>
            <span class="text-muted">
                « Mes parties » : celles où seuls mes appareils avaient un siège humain
                (@_report.Owners.Count appareil(s) marqué(s) comme moi).
            </span>
        </div>
        <form method="post" @formname="appareil" @onsubmit="ToggleMine" data-enhance="false"
              class="d-flex flex-wrap align-items-center gap-2 mt-2">
            <AntiforgeryToken/>
            @if (_device is null)
            {
                <span>Cet appareil n’a pas encore d’identifiant : ouvrir une page du jeu, puis revenir ici.</span>
            }
            else if (_report.Owners.Contains(_device))
            {
                <span>Cet appareil (<code>@Short(_device)</code>) est marqué comme <strong>moi</strong>.</span>
                <input type="hidden" name="Choice" value="not-mine"/>
                <button class="btn btn-sm btn-outline-secondary" type="submit">Ce n’est pas moi</button>
            }
            else
            {
                <span>Cet appareil (<code>@Short(_device)</code>) n’est pas marqué.</span>
                <input type="hidden" name="Choice" value="mine"/>
                <button class="btn btn-sm btn-primary" type="submit">C’est moi</button>
                <span class="text-muted">à faire une fois sur chacun de mes appareils et navigateurs</span>
            }
        </form>
    </div>
</div>

@if (_report.Games.Count == 0)
{
    <p>Aucune partie dans le journal pour l’instant.</p>
}
else
{
    var started = _games.Where(g => g.Started).ToList();
    var finished = started.Where(g => g.Outcome == GameOutcome.Finished).ToList();
    var humans = _players.Where(p => p.HasVisitorId).ToList();

    <h2 class="h5 mt-4">Chiffres clés</h2>
    <div class="row row-cols-2 row-cols-md-4 g-2 mb-3">
        @Tile("Joueurs humains", humans.Count,
            $"{humans.Count(p => p.Days.Count > 1)} revenus un autre jour"
            + (_players.Count > humans.Count ? $" · {_players.Count - humans.Count} siège(s) sans identifiant" : ""))
        @Tile("Parties créées", _games.Count,
            $"{_games.Count(g => g.Outcome == GameOutcome.NeverStarted)} jamais lancées · {_games.Count(g => g.Outcome == GameOutcome.Lobby)} dans le lobby")
        @Tile("Parties lancées", started.Count,
            $"{started.Count(g => g.Humans > 1)} avec plusieurs humains")
        @Tile("Terminées", finished.Count,
            $"{started.Count(g => g.Outcome == GameOutcome.Abandoned)} abandonnées · {started.Count(g => g.Outcome == GameOutcome.InProgress)} en cours")
        @Tile("Victoires humaines", finished.Count(g => g.Winner is { Ai: false }),
            $"{finished.Count(g => g.Winner is { Ai: true })} victoires d’une IA")
        @Tile("Durée médiane", finished.Count == 0 ? "—" : Duration(Median(finished.Select(g => g.Duration!.Value.TotalMinutes))),
            "des parties terminées")
        @Tile("Tours médians", finished.Count == 0 ? "—" : Median(finished.Select(g => (double)(g.Turns ?? 0))).ToString("0"),
            "des parties terminées")
        @Tile("Sans joker", started.Count(g => g.NoJokers),
            $"{started.Count(g => g.SeedKind == "list")} graines de la liste · {started.Count(g => g.SeedKind == "pasted")} collées")
    </div>

    <h2 class="h5 mt-4">Par nombre d’humains à la table</h2>
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
            <tr>
                <th>Humains</th>
                <th class="text-end">Lancées</th>
                <th class="text-end">Terminées</th>
                <th class="text-end">Abandonnées</th>
                <th class="text-end">En cours</th>
                <th class="text-end">Joueurs distincts</th>
                <th class="text-end">Durée médiane</th>
                <th class="text-end">Tours médians</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var group in started.GroupBy(g => g.Humans).OrderBy(g => g.Key))
            {
                var done = group.Where(g => g.Outcome == GameOutcome.Finished).ToList();
                <tr>
                    <td>@group.Key humain@(group.Key > 1 ? "s" : "") <span class="text-muted">(+ IA : @string.Join(", ", group.Select(g => g.Ais).Distinct().Order()))</span></td>
                    <td class="text-end">@group.Count()</td>
                    <td class="text-end">@done.Count</td>
                    <td class="text-end">@group.Count(g => g.Outcome == GameOutcome.Abandoned)</td>
                    <td class="text-end">@group.Count(g => g.Outcome == GameOutcome.InProgress)</td>
                    <td class="text-end">@group.SelectMany(g => g.Seats).Where(s => !s.Ai).Select(s => s.PlayerKey).Distinct().Count()</td>
                    <td class="text-end">@(done.Count == 0 ? "—" : Duration(Median(done.Select(g => g.Duration!.Value.TotalMinutes))))</td>
                    <td class="text-end">@(done.Count == 0 ? "—" : Median(done.Select(g => (double)(g.Turns ?? 0))).ToString("0"))</td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <h2 class="h5 mt-4">Par jour <span class="text-muted small">(30 derniers jours d’activité)</span></h2>
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
            <tr>
                <th>Jour</th>
                <th class="text-end">Créées</th>
                <th class="text-end">Lancées</th>
                <th class="text-end">Terminées</th>
                <th class="text-end">Joueurs</th>
                <th class="text-end">Nouveaux joueurs</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var day in Days().Take(30))
            {
                <tr>
                    <td>@day.Day.ToString("ddd dd/MM/yyyy", French)</td>
                    <td class="text-end">@day.Created</td>
                    <td class="text-end">@day.Started</td>
                    <td class="text-end">@day.Finished</td>
                    <td class="text-end">@day.Players</td>
                    <td class="text-end">@day.NewPlayers</td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <h2 class="h5 mt-4">Joueurs <span class="text-muted small">(@_players.Count)</span></h2>
    <div class="table-responsive">
        <table class="table table-sm align-middle small">
            <thead>
            <tr>
                <th>Joueur</th>
                <th>Premier passage</th>
                <th>Dernier</th>
                <th class="text-end">Jours</th>
                <th class="text-end">Créées</th>
                <th class="text-end">Rejointes</th>
                <th class="text-end">Jouées</th>
                <th class="text-end">Avec d’autres humains</th>
                <th class="text-end">Terminées</th>
                <th class="text-end">Gagnées</th>
                <th class="text-end">Abandonnées</th>
                <th class="text-end">Tuiles posées</th>
                <th class="text-end">Pioches</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var p in _players)
            {
                <tr>
                    <td>
                        @string.Join(", ", p.Names)
                        @if (p.IsOwner)
                        {
                            <span class="badge text-bg-warning ms-1">moi</span>
                        }
                        <br/><code class="text-muted">@(p.HasVisitorId ? Short(p.Key) : "sans identifiant")</code>
                    </td>
                    <td>@Time(p.FirstSeen)</td>
                    <td>@Time(p.LastSeen)</td>
                    <td class="text-end">@p.Days.Count</td>
                    <td class="text-end">@p.Created</td>
                    <td class="text-end">@p.Joined</td>
                    <td class="text-end">@p.Played</td>
                    <td class="text-end">@p.WithOtherHumans</td>
                    <td class="text-end">@p.Finished</td>
                    <td class="text-end">@p.Won</td>
                    <td class="text-end">@p.Abandoned</td>
                    <td class="text-end">@p.TilesPlayed</td>
                    <td class="text-end">@p.Draws</td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <h2 class="h5 mt-4">Parties <span class="text-muted small">(@_games.Count@(_games.Count > MaxGamesListed ? $", les {MaxGamesListed} plus récentes" : ""))</span></h2>
    <div class="table-responsive">
        <table class="table table-sm align-middle small">
            <thead>
            <tr>
                <th>Partie</th>
                <th>Créée</th>
                <th>État</th>
                <th>Table</th>
                <th class="text-end">Coups</th>
                <th class="text-end">Durée</th>
                <th>Gagnant</th>
                <th>Donne</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var g in _games.Take(MaxGamesListed))
            {
                <tr>
                    <td><code>@g.Id</code></td>
                    <td>@Time(g.CreatedAt)</td>
                    <td>@OutcomeLabel(g)</td>
                    <td>
                        @foreach (var s in g.Seats)
                        {
                            <span class="badge @(s.Ai ? "text-bg-secondary" : _report.Owners.Contains(s.PlayerKey) ? "text-bg-warning" : "text-bg-primary") me-1">
                                @s.Name@(s.Ai ? " (IA)" : "")
                            </span>
                        }
                    </td>
                    <td class="text-end">@g.Moves@(g.Turns is { } t ? $" · {t} tours" : "")</td>
                    <td class="text-end">@(g.Started ? Duration(((g.EndedAt ?? g.LastActivity) - g.StartedAt!.Value).TotalMinutes) : "")</td>
                    <td>@(g.Winner is { } w ? w.Name + (w.Ai ? " (IA)" : "") : "")</td>
                    <td>@SeedLabel(g)@(g.NoJokers ? " · sans joker" : "")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@code {
    private const int MaxGamesListed = 200;
    private static readonly System.Globalization.CultureInfo French = new("fr-FR");

    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromQuery(Name = "tout")] private string? All { get; set; }

    [SupplyParameterFromForm(FormName = "appareil")] private string? Choice { get; set; }

    private bool IncludeMine => All is "1" or "oui";

    private StatsReport _report = null!;
    private List<GameRecord> _games = [];
    private List<PlayerRecord> _players = [];

    /// <summary>This browser's anonymous id (stats.js), if it has one.</summary>
    private string? _device;

    protected override void OnInitialized()
    {
        _device = VisitorIds.Normalize(HttpContext?.Request.Cookies[VisitorIds.CookieName]);
        Load();
    }

    private void Load()
    {
        _report = GameStatistics.Build(Journal.ReadAll(), DateTimeOffset.UtcNow);
        _games = _report.Games.Where(g => IncludeMine || _report.HasOthers(g)).ToList();
        _players = _report.Players.Where(p => IncludeMine || !p.IsOwner).ToList();
    }

    private void ToggleMine()
    {
        if (_device is null) return;
        Journal.Record(new JournalEntry
        {
            Kind = Choice == "not-mine" ? JournalKinds.NotMine : JournalKinds.Mine,
            Visitor = _device
        });
        Load();
    }

    private sealed record DayRow(DateOnly Day, int Created, int Started, int Finished, int Players, int NewPlayers);

    /// <summary>Days with a game created, started or finished, most recent first.</summary>
    private IEnumerable<DayRow> Days()
    {
        static DateOnly D(DateTimeOffset at) => DateOnly.FromDateTime(at.UtcDateTime);
        var firstDay = _players.ToDictionary(p => p.Key, p => D(p.FirstSeen));
        var days = _games.Select(g => D(g.CreatedAt))
            .Concat(_games.Where(g => g.StartedAt is not null).Select(g => D(g.StartedAt!.Value)))
            .Distinct()
            .OrderDescending();
        foreach (var day in days)
        {
            var keys = _games.Where(g => D(g.CreatedAt) == day || g.StartedAt is { } s && D(s) == day)
                .SelectMany(g => g.Seats).Where(s => !s.Ai).Select(s => s.PlayerKey)
                .Where(k => firstDay.ContainsKey(k))
                .ToHashSet();
            yield return new DayRow(
                day,
                _games.Count(g => D(g.CreatedAt) == day),
                _games.Count(g => g.StartedAt is { } s && D(s) == day),
                _games.Count(g => g.EndedAt is { } e && D(e) == day),
                keys.Count,
                keys.Count(k => firstDay[k] == day));
        }
    }

    private static RenderFragment Tile(string label, object value, string detail) =>
        @<div class="col">
            <div class="border rounded p-2 h-100">
                <div class="small text-muted">@label</div>
                <div class="fs-4 fw-semibold">@value</div>
                <div class="small text-muted">@detail</div>
            </div>
        </div>;

    private static string OutcomeLabel(GameRecord g) => g.Outcome switch
    {
        GameOutcome.Lobby => "Dans le lobby",
        GameOutcome.NeverStarted => "Jamais lancée",
        GameOutcome.InProgress => "En cours",
        GameOutcome.Finished => "Terminée",
        GameOutcome.Abandoned => "Abandonnée",
        _ => g.Outcome.ToString()
    };

    private static string SeedLabel(GameRecord g) => g.SeedKind switch
    {
        "list" => "graine de la liste",
        "pasted" => "graine collée",
        "random" => "au hasard",
        _ => ""
    };

    private static double Median(IEnumerable<double> values)
    {
        var sorted = values.Order().ToList();
        if (sorted.Count == 0) return 0;
        var mid = sorted.Count / 2;
        return sorted.Count % 2 == 1 ? sorted[mid] : (sorted[mid - 1] + sorted[mid]) / 2;
    }

    private static string Duration(double minutes) =>
        minutes < 1 ? "< 1 min"
        : minutes < 60 ? $"{(int)minutes} min"
        : $"{(int)(minutes / 60)} h {(int)minutes % 60:00}";

    private static string Day(DateTimeOffset at) => at.UtcDateTime.ToString("dd/MM/yyyy");
    private static string Time(DateTimeOffset at) => at.UtcDateTime.ToString("dd/MM HH:mm");
    private static string Short(string id) => id.Length > 8 ? id[..8] : id;
}
