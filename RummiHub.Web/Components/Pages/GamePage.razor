@page "/game/{GameId}"
@using RummiHub.Web.Models
@rendermode InteractiveServer
@implements IAsyncDisposable

<PageTitle>Rummikub - @(GameId ?? "Game")</PageTitle>

@if (!_isConnected)
{
    <div class="game-container">
        <div class="loading-state">
            @if (string.IsNullOrEmpty(_error))
            {
                <div class="spinner"></div>
                <p>Connecting to game...</p>
            }
        </div>
    </div>
}
else if (_gameState == null)
{
    <div class="game-container">
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading game...</p>
        </div>
    </div>
}
else
{
    <div class="game-container @(IsMyTurn ? "is-my-turn" : "")" tabindex="0" @onkeydown="OnKeyDown">
        <!-- Compact top bar -->
        <header class="game-header">
            <div class="game-meta">
                <span class="meta-chip turn-chip" title="Current turn">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="23 4 23 10 17 10"/>
                        <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/>
                    </svg>
                    Turn @_gameState.Turn
                </span>
                <!-- A drawn tile flies into the rack out of this chip. -->
                <span class="meta-chip pool-chip" title="Tiles left in pool" data-anim-origin="pool">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
                    </svg>
                    @_gameState.TilePoolCount in pool
                </span>
                @* The server sends the seed only at game over: it rebuilds every rack. *@
                @if (!string.IsNullOrEmpty(_gameState.DistributionSeed))
                {
                    <span class="meta-chip seed-chip" title="Distribution seed">
                        Seed:&nbsp;<strong>@_gameState.DistributionSeed</strong>
                        <button type="button"
                                class="seed-replay-btn @(_seedSaved ? "saved" : "")"
                                title="Save this seed to the lobby so you can replay the same game"
                                disabled="@_seedSaved"
                                @onclick="OnSaveSeed">
                            @if (_seedSaved)
                            {
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                    <polyline points="20 6 9 17 4 12"/>
                                </svg>
                                <span>Saved</span>
                            }
                            else
                            {
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <line x1="12" y1="5" x2="12" y2="19"/>
                                    <line x1="5" y1="12" x2="19" y2="12"/>
                                </svg>
                                <span>Save seed</span>
                            }
                        </button>
                    </span>
                }
            </div>
            <div class="game-id" title="Game code">#@_gameState.GameId</div>
        </header>

        <!-- Players bar -->
        <div class="players-bar">
            @foreach (var (player, index) in _gameState.Players.Select((p, i) => (p, i)))
            {
                var isCurrent = index == _gameState.CurrentPlayerIndex && !_gameState.IsGameOver;
                var isMe = player.Name == PlayerName;
                <!-- The tiles a player lays fly onto the board out of their chip — unless they
                     come from my own play zone. -->
                <div class="player-chip @(isCurrent ? "current" : "") @(isMe ? "me" : "")"
                     data-anim-origin="@(isCurrent ? "mover" : null)">
                    @if (isCurrent)
                    {
                        <span class="active-pulse" aria-hidden="true"></span>
                    }
                    <span class="player-name">
                        @player.Name
                        @if (isMe)
                        {
                            <small>(you)</small>
                        }
                    </span>
                    <span class="tile-count" title="Tiles in rack">@player.TileCount</span>
                </div>
            }
        </div>

        @if (_gameState.IsGameOver)
        {
            <div class="game-over">
                <div class="trophy">🏆</div>
                <h2>@_gameState.WinnerName won the game!</h2>
                <div class="game-over-actions">
                    <button @onclick="OnReplayAnimation" class="btn-replay" disabled="@(!_canReplay || _isLoading)"
                            title="Replay the winning move">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2">
                            <polyline points="1 4 1 10 7 10"/>
                            <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/>
                        </svg>
                        Replay animation
                    </button>
                    <button class="btn-back-lobby" @onclick="@(() => Navigation.NavigateTo("/lobby"))">
                        Back to lobby
                    </button>
                </div>
            </div>
        }
        else
        {
            <!-- Turn status banner -->
            <div class="turn-banner @(IsMyTurn ? "my-turn" : "waiting")">
                @if (AwaitingMyConfirmation)
                {
                    <span class="turn-banner-text">Move played — watch it land, replay it, then pass the turn.</span>
                }
                else if (_gameState.AwaitingConfirmation)
                {
                    <span class="dot-pulse" aria-hidden="true"></span>
                    <span class="turn-banner-text">@CurrentPlayerName is reviewing their move…</span>
                }
                else if (IsMyTurn)
                {
                    <span class="turn-banner-text">Your turn — pick tiles to play, or draw.</span>
                }
                else
                {
                    <span class="dot-pulse" aria-hidden="true"></span>
                    <span class="turn-banner-text">Waiting for @CurrentPlayerName…</span>
                }
                @* Review mode already offers this next to "Next player". Everywhere else —
                   while an AI plays, and once that move has landed — the last board story
                   stays replayable from here. *@
                @if (!AwaitingMyConfirmation)
                {
                    <button @onclick="OnReplayAnimation" class="btn-replay" disabled="@(!_canReplay || _isLoading)"
                            title="Replay the last move">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2">
                            <polyline points="1 4 1 10 7 10"/>
                            <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/>
                        </svg>
                        Replay animation
                    </button>
                }
            </div>
        }

        <!-- Board. Staged: each change plays as lift → make room → place, so a tile at rest
             never covers another. -->
        <div class="solution-section" data-anim-scope="board" data-anim-staged data-anim-enter-from="mover">
            <SolutionComponent Solution="_gameState.Board" HighlightIndices="_highlightIndices"
                              ModifiedSetIndices="_modifiedSetIndices"/>
        </div>

        <!-- Error play -->
        @if (!string.IsNullOrEmpty(_errorPlay))
        {
            <div class="error-message">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"/>
                    <line x1="12" y1="8" x2="12" y2="12"/>
                    <line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
                <span>@_errorPlay</span>
            </div>
        }

        <!-- My rack section -->
        @if (_rackTiles.Count > 0 && !_gameState.IsGameOver)
        {
            <div class="my-rack-section @(IsMyTurn ? "active-turn" : "")">
                <h3 class="rack-title">
                    <span>Your tiles (@_rackTiles.Count)</span>
                    @if (AwaitingMyConfirmation)
                    {
                        <span class="keyboard-hint">
                            <kbd>Enter</kbd> next player
                        </span>
                    }
                    else if (IsMyTurn)
                    {
                        <span class="keyboard-hint">
                            <kbd>Enter</kbd> play · <kbd>Esc</kbd> clear
                        </span>
                    }
                </h3>

                <!-- One rack for both states (readonly out of turn): keeping the same DOM
                     subtree across turn flips lets a draw's flight survive the re-render.
                     Enter-only scope: a drawn tile flies in from the pool and deselections
                     fly home, but internal reshuffles display instantly. -->
                <div class="available-tiles-section">
                    <h4>Available tiles</h4>
                    <div class="tiles-container @(CanAct ? "" : "readonly")"
                         data-anim-scope="rack" data-anim-enter-only data-anim-enter-from="pool">
                        @foreach (var tileGroup in GetGroupedTiles())
                        {
                            var tileType = tileGroup.Key;
                            var totalCount = tileGroup.Count();
                            var selectedCount = GetSelectedCountForTile(tileType);
                            var remainingCount = totalCount - selectedCount;
                            var isFullySelected = remainingCount == 0;

                            <div class="tile-stack @(isFullySelected ? "fully-selected" : "")"
                                 @onclick="() => OnTileStackClick(tileType)">
                                @if (remainingCount > 0)
                                {
                                    for (var i = 0; i < remainingCount; i++)
                                    {
                                        var stackOffset = i * 3;
                                        <div class="stacked-tile"
                                             style="z-index: @(100 - i); transform: translate(@(stackOffset)px, @(-stackOffset)px);">
                                            <TileComponent Tile="tileType" ShouldHighlight="false"/>
                                        </div>
                                    }
                                    @if (remainingCount > 1)
                                    {
                                        <div class="count-indicator">@remainingCount</div>
                                    }
                                }
                                else
                                {
                                    <!-- Not measured for animation, so selecting the last copy
                                         flies to the selection instead of popping there. -->
                                    <div class="stacked-tile greyed-out" data-anim-ignore>
                                        <TileComponent Tile="tileType" ShouldHighlight="false"/>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <!-- Play zone, BELOW the rack and always rendered at a stable height, so
                     picking tiles never shifts the rack. Shows only the current selection.
                     Hint fills that selection on demand; nothing is suggested until then. -->
                <div class="selected-tiles-section play-zone">
                    <div class="play-zone-header">
                        <h4>
                            Tiles to play@(SelectedTilesForPlay.Any() ? $" ({SelectedTilesForPlay.Count})" : "")
                        </h4>
                        @if (CanAct)
                        {
                            <button type="button" class="btn-hint @(_hintNoMove ? "no-move" : "")" @onclick="RequestHint"
                                    disabled="@(HintPending || _hintNoMove || _isLoading)"
                                    title="@(_hintNoMove ? "Nothing to play — draw a tile." : "Select the best tiles to play")">
                                @if (HintPending)
                                {
                                    <span class="solver-dot"></span>
                                    <span>Computing hint…</span>
                                }
                                else
                                {
                                    <span>Hint</span>
                                }
                            </button>
                        }
                    </div>
                    <div class="selected-tiles-display" data-anim-scope="selection">
                        @if (IsMyTurn && SelectedTilesForPlay.Any())
                        {
                            @foreach (var tile in SelectedTilesForPlay)
                            {
                                <div class="selected-tile-wrapper"
                                     @onclick="() => OnSelectedTileClick(tile)">
                                    <TileComponent Tile="tile" ShouldHighlight="false"/>
                                </div>
                            }
                        }
                        else if (ShowDrawHint)
                        {
                            <div class="play-zone-placeholder">
                                Nothing to play — draw a tile.
                            </div>
                        }
                        else
                        {
                            <div class="play-zone-placeholder">
                                @(IsMyTurn ? "Click your tiles to select them — they land here." : "")
                            </div>
                        }
                    </div>
                </div>

                <!-- Action buttons: always rendered (Draw disabled out of turn) so the
                     section height never jumps between turns. -->
                <div class="human-actions-buttons">
                    @if (AwaitingMyConfirmation)
                    {
                        <button @onclick="OnReplayAnimation" class="btn-replay" disabled="@(!_canReplay || _isLoading)">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2">
                                <polyline points="1 4 1 10 7 10"/>
                                <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/>
                            </svg>
                            Replay animation
                        </button>
                        <button @onclick="OnConfirmEndTurn" class="btn-play" disabled="@_isLoading">
                            @if (_isLoading)
                            {
                                <span class="spinner"></span>
                                <span>Passing…</span>
                            }
                            else
                            {
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="2">
                                    <polyline points="9 6 15 12 9 18"/>
                                </svg>
                                <span>Next player</span>
                            }
                        </button>
                    }
                    else if (SelectedTilesForPlay.Any())
                    {
                        <button @onclick="OnClearSelection" class="btn-clear" disabled="@_isLoading">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2">
                                <path d="M18 6L6 18M6 6l12 12"/>
                            </svg>
                            Clear
                        </button>
                        <button @onclick="() => OnPlaySelection(autoContinue: false)" class="btn-play-review"
                                disabled="@_isLoading"
                                title="Play, watch the animation, then pass the turn yourself">
                            @if (_isLoading && !_loadingAutoContinue)
                            {
                                <span class="spinner"></span>
                                <span>Validating...</span>
                            }
                            else
                            {
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="2">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                    <circle cx="12" cy="12" r="3"/>
                                </svg>
                                <span>Play &amp; review</span>
                            }
                        </button>
                        <button @onclick="() => OnPlaySelection(autoContinue: true)" class="btn-play"
                                disabled="@_isLoading"
                                title="Play and let the game continue automatically">
                            @if (_isLoading && _loadingAutoContinue)
                            {
                                <span class="spinner"></span>
                                <span>Validating...</span>
                            }
                            else
                            {
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="2">
                                    <circle cx="12" cy="12" r="10"/>
                                    <polygon points="10,8 16,12 10,16 10,8"/>
                                </svg>
                                <span>Play &amp; continue</span>
                            }
                        </button>
                    }
                    else
                    {
                        <button @onclick="OnDrawTile" class="btn-draw"
                                disabled="@(!IsMyTurn || _isLoading || _gameState.TilePoolCount == 0)">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2">
                                <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
                            </svg>
                            Draw (@_gameState.TilePoolCount remaining)
                        </button>
                    }
                </div>
            </div>
        }
    </div>
}

<!-- Toast for drawn tile -->
@if (_showDrawnTileToast && _drawnTile != null)
{
    <div class="toast-notification drawn-tile-toast">
        <div class="toast-header">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
            </svg>
            <span>Tile drawn!</span>
        </div>
        <div class="toast-content">
            <TileComponent Tile="_drawnTile.Value" ShouldHighlight="false"/>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger mt-3">@_error</div>
}

<style>
    .game-container {
        /* No fixed column: on a wide monitor a 1300px card left the table
           floating in empty space. It fills the area beside the sidebar. */
        max-width: none;
        margin: 12px;
        padding: 16px 20px;
        font-family: Arial, sans-serif;
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        outline: none;
        transition: box-shadow 0.3s ease;
        display: flex;
        flex-direction: column;
        box-sizing: border-box;
    }

    /* Sidebar is beside the page from 641px up, so the card can take the
       viewport height. Below that the menu stacks on top and the card
       stays as tall as its content. 1.1rem is .content's top padding. */
    @@media (min-width: 641px) {
        .game-container {
            min-height: calc(100vh - 1.1rem - 24px);
        }
    }

    .game-container:has(.loading-state) {
        justify-content: center;
    }

    .game-container.is-my-turn {
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1), 0 0 0 3px rgba(33, 150, 243, 0.18);
    }

    /* Compact header */
    .game-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        padding: 6px 4px 14px 4px;
        border-bottom: 1px solid #eee;
        margin-bottom: 14px;
    }

    .game-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: center;
    }

    .meta-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 10px;
        font-size: 0.82rem;
        color: #555;
        background: #f4f6f8;
        border: 1px solid #e2e6ea;
        border-radius: 999px;
        line-height: 1;
    }

    .meta-chip svg {
        flex-shrink: 0;
        opacity: 0.75;
    }

    .turn-chip {
        color: #1565c0;
        background: #e3f2fd;
        border-color: #bbdefb;
        font-weight: 600;
    }

    .pool-chip {
        color: #6a1b9a;
        background: #f3e5f5;
        border-color: #e1bee7;
    }

    .seed-chip {
        position: relative;
    }

    .seed-chip strong {
        color: #555;
        font-family: monospace;
        user-select: all;
    }

    /* Reveals on hover/focus of the seed chip: saves the seed to the lobby for a replay. */
    .seed-replay-btn {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        margin-left: -6px; /* cancels the chip's flex gap while collapsed */
        border: none;
        border-radius: 999px;
        background: linear-gradient(135deg, #4caf50, #388e3c);
        color: #fff;
        font-size: 0.72rem;
        font-weight: 600;
        line-height: 1;
        cursor: pointer;
        white-space: nowrap;
        overflow: hidden;
        max-width: 0;
        padding: 4px 0;
        opacity: 0;
        pointer-events: none;
        transition: max-width 0.25s ease, padding 0.25s ease, margin-left 0.25s ease, opacity 0.2s ease;
    }

    .seed-chip:hover .seed-replay-btn,
    .seed-chip:focus-within .seed-replay-btn,
    .seed-replay-btn.saved {
        max-width: 130px;
        margin-left: 0;
        padding: 4px 9px;
        opacity: 1;
        pointer-events: auto;
    }

    .seed-replay-btn:hover {
        background: linear-gradient(135deg, #388e3c, #2e7d32);
    }

    .seed-replay-btn:disabled,
    .seed-replay-btn.saved {
        cursor: default;
        background: linear-gradient(135deg, #66bb6a, #43a047);
    }

    .seed-replay-btn svg {
        flex-shrink: 0;
    }

    .game-id {
        font-family: monospace;
        font-size: 0.78rem;
        color: #999;
        letter-spacing: 0.02em;
        user-select: all;
    }

    /* Loading */
    .loading-state {
        text-align: center;
        padding: 60px 20px;
    }

    .loading-state p {
        margin-top: 15px;
        color: #777;
        font-size: 1.1rem;
    }

    /* Players bar */
    .players-bar {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        justify-content: center;
        padding: 12px;
        background: linear-gradient(135deg, #f8f9fa, #ffffff);
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        margin-bottom: 20px;
    }

    .player-chip {
        position: relative;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 16px;
        background: #ffffff;
        border: 2px solid #e0e0e0;
        border-radius: 8px;
        transition: all 0.3s ease;
        min-width: 140px;
    }

    .player-chip.current {
        background: linear-gradient(135deg, #e8f5e9, #f1f8f4);
        border: 2px solid #4caf50;
        box-shadow: 0 3px 10px rgba(76, 175, 80, 0.2);
    }

    .active-pulse {
        position: absolute;
        top: -5px;
        left: -5px;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: #4caf50;
        box-shadow: 0 0 0 0 rgba(76, 175, 80, 0.6);
        animation: active-ring 1.6s ease-out infinite;
    }

    @@keyframes active-ring {
        0% { box-shadow: 0 0 0 0 rgba(76, 175, 80, 0.6); }
        70% { box-shadow: 0 0 0 10px rgba(76, 175, 80, 0); }
        100% { box-shadow: 0 0 0 0 rgba(76, 175, 80, 0); }
    }

    .player-chip.me {
        border-color: #2196f3;
    }

    .player-chip.me.current {
        border-color: #4caf50;
        background: linear-gradient(135deg, #e3f2fd, #e8f5e9);
    }

    .player-chip .player-name {
        flex: 1;
        font-weight: 600;
        color: #333;
        font-size: 1rem;
    }

    .player-chip .player-name small {
        font-weight: 400;
        color: #999;
        font-size: 0.8rem;
    }

    .player-chip .tile-count {
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 32px;
        height: 32px;
        background: linear-gradient(135deg, #e3f2fd, #bbdefb);
        color: #1565c0;
        font-weight: 700;
        font-size: 0.95rem;
        border-radius: 6px;
        padding: 0 8px;
    }

    .player-chip.current .tile-count {
        background: linear-gradient(135deg, #c8e6c9, #a5d6a7);
        color: #2e7d32;
    }

    /* Game over */
    .game-over {
        text-align: center;
        background: linear-gradient(135deg, #f1f8e9, #fff8e1);
        border: 2px solid #8bc34a;
        border-radius: 12px;
        padding: 24px 20px;
        margin-bottom: 20px;
        box-shadow: 0 4px 16px rgba(139, 195, 74, 0.18);
    }

    .game-over .trophy {
        font-size: 2.5rem;
        line-height: 1;
        margin-bottom: 6px;
        animation: trophy-bounce 1.6s ease-in-out infinite;
    }

    @@keyframes trophy-bounce {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-6px); }
    }

    .game-over h2 {
        color: #4caf50;
        font-size: 1.6rem;
        margin: 0 0 14px 0;
    }

    .game-over-actions {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    /* Same control as the review bar, but it must not stretch the banner or shift the board. */
    .turn-banner .btn-replay,
    .game-over .btn-replay {
        flex: none;
        min-width: 0;
    }

    .turn-banner .btn-replay {
        padding: 6px 12px;
        font-size: 0.85rem;
        gap: 6px;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(126, 87, 194, 0.25);
    }

    .btn-back-lobby {
        padding: 10px 22px;
        font-size: 0.95rem;
        font-weight: 600;
        color: #fff;
        background: linear-gradient(135deg, #2196f3, #1976d2);
        border: none;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.2s ease;
        box-shadow: 0 3px 10px rgba(33, 150, 243, 0.3);
    }

