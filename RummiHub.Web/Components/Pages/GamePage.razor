@page "/game/{GameId}"
@using RummiHub.Web.Models
@rendermode InteractiveServer
@implements IAsyncDisposable

<PageTitle>Rummikub - @(GameId ?? "Game")</PageTitle>

@if (!_isConnected)
{
    <div class="game-container">
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Connecting to game...</p>
        </div>
    </div>
}
else if (_gameState == null)
{
    <div class="game-container">
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading game...</p>
        </div>
    </div>
}
else
{
    <div class="game-container @(IsMyTurn ? "is-my-turn" : "")" tabindex="0" @onkeydown="OnKeyDown">
        <!-- Compact top bar -->
        <header class="game-header">
            <div class="game-meta">
                <span class="meta-chip turn-chip" title="Current turn">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="23 4 23 10 17 10"/>
                        <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/>
                    </svg>
                    Turn @_gameState.Turn
                </span>
                <span class="meta-chip pool-chip" title="Tiles left in pool">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
                    </svg>
                    @_gameState.TilePoolCount in pool
                </span>
                <span class="meta-chip seed-chip" title="Distribution seed">
                    Seed:&nbsp;<strong>@_gameState.DistributionSeed</strong>
                    <button type="button"
                            class="seed-replay-btn @(_seedSaved ? "saved" : "")"
                            title="Save this seed to the lobby so you can replay the same game"
                            disabled="@_seedSaved"
                            @onclick="OnSaveSeed">
                        @if (_seedSaved)
                        {
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                            <span>Saved</span>
                        }
                        else
                        {
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="12" y1="5" x2="12" y2="19"/>
                                <line x1="5" y1="12" x2="19" y2="12"/>
                            </svg>
                            <span>Save seed</span>
                        }
                    </button>
                </span>
            </div>
            <div class="game-id" title="Game code">#@_gameState.GameId</div>
        </header>

        <!-- Players bar -->
        <div class="players-bar">
            @foreach (var (player, index) in _gameState.Players.Select((p, i) => (p, i)))
            {
                var isCurrent = index == _gameState.CurrentPlayerIndex && !_gameState.IsGameOver;
                var isMe = player.Name == PlayerName;
                <div class="player-chip @(isCurrent ? "current" : "") @(isMe ? "me" : "")">
                    @if (isCurrent)
                    {
                        <span class="active-pulse" aria-hidden="true"></span>
                    }
                    <span class="player-name">
                        @player.Name
                        @if (isMe)
                        {
                            <small>(you)</small>
                        }
                    </span>
                    <span class="tile-count" title="Tiles in rack">@player.TileCount</span>
                </div>
            }
        </div>

        @if (_gameState.IsGameOver)
        {
            <div class="game-over">
                <div class="trophy">🏆</div>
                <h2>@_gameState.WinnerName won the game!</h2>
                <button class="btn-back-lobby" @onclick="@(() => Navigation.NavigateTo("/lobby"))">
                    Back to lobby
                </button>
            </div>
        }
        else
        {
            <!-- Turn status banner -->
            <div class="turn-banner @(IsMyTurn ? "my-turn" : "waiting")">
                @if (IsMyTurn)
                {
                    <span class="turn-banner-text">Your turn — pick tiles to play, or draw.</span>
                    <div class="solver-status @(_optimalReady ? "ready" : "computing")">
                        @if (_optimalReady)
                        {
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                            <span>Hint ready</span>
                        }
                        else
                        {
                            <span class="solver-dot"></span>
                            <span>Computing hint…</span>
                        }
                    </div>
                }
                else
                {
                    <span class="dot-pulse" aria-hidden="true"></span>
                    <span class="turn-banner-text">Waiting for @CurrentPlayerName…</span>
                }
            </div>
        }

        <!-- Board -->
        <div class="solution-section" data-anim-scope>
            <SolutionComponent Solution="_gameState.Board" HighlightTiles="_highlightTiles"/>
        </div>

        <!-- Error play -->
        @if (!string.IsNullOrEmpty(_errorPlay))
        {
            <div class="error-message">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"/>
                    <line x1="12" y1="8" x2="12" y2="12"/>
                    <line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
                <span>@_errorPlay</span>
            </div>
        }

        <!-- Optimal play hint (shown to the player who just acted, cleared next turn) -->
        @if (_optimalPlayTiles is { Count: > 0 })
        {
            <div class="optimal-play-section">
                <h4>Optimal play you could have made this turn</h4>
                <div class="optimal-play-tiles">
                    @foreach (var tile in _optimalPlayTiles)
                    {
                        <TileComponent Tile="tile" ShouldHighlight="false"/>
                    }
                </div>
            </div>
        }

        <!-- My rack section -->
        @if (_rackTiles.Count > 0 && !_gameState.IsGameOver)
        {
            <div class="my-rack-section @(IsMyTurn ? "active-turn" : "")">
                <h3 class="rack-title">
                    <span>Your tiles (@_rackTiles.Count)</span>
                    @if (IsMyTurn)
                    {
                        <span class="keyboard-hint">
                            <kbd>Enter</kbd> play · <kbd>Esc</kbd> clear
                        </span>
                    }
                </h3>

                @if (IsMyTurn)
                {
                    <!-- Selected tiles -->
                    @if (SelectedTilesForPlay.Any())
                    {
                        <div class="selected-tiles-section">
                            <h4>Selected tiles (@SelectedTilesForPlay.Count)</h4>
                            <div class="selected-tiles-display" data-anim-scope>
                                @foreach (var tileInstance in _selectedTileInstances)
                                {
                                    <div class="selected-tile-wrapper"
                                         @onclick="() => OnTileInstanceClick(tileInstance)">
                                        <TileComponent Tile="tileInstance.Tile" ShouldHighlight="false"/>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- Available tiles (clickable) -->
                    <div class="available-tiles-section">
                        <h4>Available tiles</h4>
                        <div class="tiles-container" data-anim-scope>
                            @foreach (var tileGroup in GetGroupedTiles())
                            {
                                var tileType = tileGroup.Key;
                                var totalCount = tileGroup.Count();
                                var selectedCount = GetSelectedCountForTile(tileType);
                                var remainingCount = totalCount - selectedCount;
                                var isFullySelected = remainingCount == 0;

                                <div class="tile-stack @(isFullySelected ? "fully-selected" : "")"
                                     @onclick="() => OnTileStackClick(tileType)">
                                    @if (remainingCount > 0)
                                    {
                                        for (var i = 0; i < remainingCount; i++)
                                        {
                                            var stackOffset = i * 3;
                                            <div class="stacked-tile"
                                                 style="z-index: @(100 - i); transform: translate(@(stackOffset)px, @(-stackOffset)px);">
                                                <TileComponent Tile="tileType" ShouldHighlight="false"/>
                                            </div>
                                        }
                                        @if (remainingCount > 1)
                                        {
                                            <div class="count-indicator">@remainingCount</div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="stacked-tile greyed-out">
                                            <TileComponent Tile="tileType" ShouldHighlight="false"/>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Action buttons -->
                    <div class="human-actions-buttons">
                        @if (SelectedTilesForPlay.Any())
                        {
                            <button @onclick="OnClearSelection" class="btn-clear" disabled="@_isLoading">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="2">
                                    <path d="M18 6L6 18M6 6l12 12"/>
                                </svg>
                                Clear
                            </button>
                            <button @onclick="OnPlaySelection" class="btn-play" disabled="@_isLoading">
                                @if (_isLoading)
                                {
                                    <span class="spinner"></span>
                                    <span>Validating...</span>
                                }
                                else
                                {
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="2">
                                        <circle cx="12" cy="12" r="10"/>
                                        <polygon points="10,8 16,12 10,16 10,8"/>
                                    </svg>
                                    <span>Play selection</span>
                                }
                            </button>
                        }
                        else
                        {
                            <button @onclick="OnDrawTile" class="btn-draw"
                                    disabled="@(_isLoading || _gameState.TilePoolCount == 0)">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="2">
                                    <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
                                </svg>
                                Draw (@_gameState.TilePoolCount remaining)
                            </button>
                        }
                    </div>
                }
                else
                {
                    <!-- Read-only rack display when not my turn -->
                    <div class="tiles-container readonly">
                        @foreach (var tileGroup in GetGroupedTiles())
                        {
                            var tileType = tileGroup.Key;
                            var count = tileGroup.Count();
                            <div class="tile-stack">
                                @for (var i = 0; i < count; i++)
                                {
                                    var stackOffset = i * 3;
                                    <div class="stacked-tile"
                                         style="z-index: @(100 - i); transform: translate(@(stackOffset)px, @(-stackOffset)px);">
                                        <TileComponent Tile="tileType" ShouldHighlight="false"/>
                                    </div>
                                }
                                @if (count > 1)
                                {
                                    <div class="count-indicator">@count</div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
}

<!-- Toast for drawn tile -->
@if (_showDrawnTileToast && _drawnTile != null)
{
    <div class="toast-notification drawn-tile-toast">
        <div class="toast-header">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
            </svg>
            <span>Tile drawn!</span>
        </div>
        <div class="toast-content">
            <TileComponent Tile="_drawnTile.Value" ShouldHighlight="false"/>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger mt-3">@_error</div>
}

<style>
    .game-container {
        max-width: 1300px;
        margin: 16px auto 140px auto;
        padding: 16px 20px;
        font-family: Arial, sans-serif;
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        outline: none;
        transition: box-shadow 0.3s ease;
    }

    .game-container.is-my-turn {
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1), 0 0 0 3px rgba(33, 150, 243, 0.18);
    }

    /* Compact header */
    .game-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        padding: 6px 4px 14px 4px;
        border-bottom: 1px solid #eee;
        margin-bottom: 14px;
    }

    .game-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: center;
    }

    .meta-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 10px;
        font-size: 0.82rem;
        color: #555;
        background: #f4f6f8;
        border: 1px solid #e2e6ea;
        border-radius: 999px;
        line-height: 1;
    }

    .meta-chip svg {
        flex-shrink: 0;
        opacity: 0.75;
    }

    .turn-chip {
        color: #1565c0;
        background: #e3f2fd;
        border-color: #bbdefb;
        font-weight: 600;
    }

    .pool-chip {
        color: #6a1b9a;
        background: #f3e5f5;
        border-color: #e1bee7;
    }

    .seed-chip {
        position: relative;
    }

    .seed-chip strong {
        color: #555;
        font-family: monospace;
        user-select: all;
    }

    /* Reveals on hover/focus of the seed chip: saves the seed to the lobby for a replay. */
    .seed-replay-btn {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        margin-left: -6px; /* cancels the chip's flex gap while collapsed */
        border: none;
        border-radius: 999px;
        background: linear-gradient(135deg, #4caf50, #388e3c);
        color: #fff;
        font-size: 0.72rem;
        font-weight: 600;
        line-height: 1;
        cursor: pointer;
        white-space: nowrap;
        overflow: hidden;
        max-width: 0;
        padding: 4px 0;
        opacity: 0;
        pointer-events: none;
        transition: max-width 0.25s ease, padding 0.25s ease, margin-left 0.25s ease, opacity 0.2s ease;
    }

    .seed-chip:hover .seed-replay-btn,
    .seed-chip:focus-within .seed-replay-btn,
    .seed-replay-btn.saved {
        max-width: 130px;
        margin-left: 0;
        padding: 4px 9px;
        opacity: 1;
        pointer-events: auto;
    }

    .seed-replay-btn:hover {
        background: linear-gradient(135deg, #388e3c, #2e7d32);
    }

    .seed-replay-btn:disabled,
    .seed-replay-btn.saved {
        cursor: default;
        background: linear-gradient(135deg, #66bb6a, #43a047);
    }

    .seed-replay-btn svg {
        flex-shrink: 0;
    }

    .game-id {
        font-family: monospace;
        font-size: 0.78rem;
        color: #999;
        letter-spacing: 0.02em;
        user-select: all;
    }

    /* Loading */
    .loading-state {
        text-align: center;
        padding: 60px 20px;
    }

    .loading-state p {
        margin-top: 15px;
        color: #777;
        font-size: 1.1rem;
    }

    /* Players bar */
    .players-bar {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        justify-content: center;
        padding: 12px;
        background: linear-gradient(135deg, #f8f9fa, #ffffff);
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        margin-bottom: 20px;
    }

    .player-chip {
        position: relative;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 16px;
        background: #ffffff;
        border: 2px solid #e0e0e0;
        border-radius: 8px;
        transition: all 0.3s ease;
        min-width: 140px;
    }

    .player-chip.current {
        background: linear-gradient(135deg, #e8f5e9, #f1f8f4);
        border: 2px solid #4caf50;
        box-shadow: 0 3px 10px rgba(76, 175, 80, 0.2);
    }

    .active-pulse {
        position: absolute;
        top: -5px;
        left: -5px;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: #4caf50;
        box-shadow: 0 0 0 0 rgba(76, 175, 80, 0.6);
        animation: active-ring 1.6s ease-out infinite;
    }

    @@keyframes active-ring {
        0% { box-shadow: 0 0 0 0 rgba(76, 175, 80, 0.6); }
        70% { box-shadow: 0 0 0 10px rgba(76, 175, 80, 0); }
        100% { box-shadow: 0 0 0 0 rgba(76, 175, 80, 0); }
    }

    .player-chip.me {
        border-color: #2196f3;
    }

    .player-chip.me.current {
        border-color: #4caf50;
        background: linear-gradient(135deg, #e3f2fd, #e8f5e9);
    }

    .player-chip .player-name {
        flex: 1;
        font-weight: 600;
        color: #333;
        font-size: 1rem;
    }

    .player-chip .player-name small {
        font-weight: 400;
        color: #999;
        font-size: 0.8rem;
    }

    .player-chip .tile-count {
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 32px;
        height: 32px;
        background: linear-gradient(135deg, #e3f2fd, #bbdefb);
        color: #1565c0;
        font-weight: 700;
        font-size: 0.95rem;
        border-radius: 6px;
        padding: 0 8px;
    }

    .player-chip.current .tile-count {
        background: linear-gradient(135deg, #c8e6c9, #a5d6a7);
        color: #2e7d32;
    }

    /* Game over */
    .game-over {
        text-align: center;
        background: linear-gradient(135deg, #f1f8e9, #fff8e1);
        border: 2px solid #8bc34a;
        border-radius: 12px;
        padding: 24px 20px;
        margin-bottom: 20px;
        box-shadow: 0 4px 16px rgba(139, 195, 74, 0.18);
    }

    .game-over .trophy {
        font-size: 2.5rem;
        line-height: 1;
        margin-bottom: 6px;
        animation: trophy-bounce 1.6s ease-in-out infinite;
    }

    @@keyframes trophy-bounce {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-6px); }
    }

    .game-over h2 {
        color: #4caf50;
        font-size: 1.6rem;
        margin: 0 0 14px 0;
    }

    .btn-back-lobby {
        padding: 10px 22px;
        font-size: 0.95rem;
        font-weight: 600;
        color: #fff;
        background: linear-gradient(135deg, #2196f3, #1976d2);
        border: none;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.2s ease;
        box-shadow: 0 3px 10px rgba(33, 150, 243, 0.3);
    }

    .btn-back-lobby:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(33, 150, 243, 0.4);
    }

    /* Turn banner */
    .turn-banner {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
        padding: 10px 16px;
        border-radius: 10px;
        font-size: 0.95rem;
        font-weight: 600;
        margin-bottom: 14px;
    }

    .turn-banner.my-turn {
        background: linear-gradient(135deg, #e8f5e9, #f1f8f4);
        color: #2e7d32;
        border: 1px solid #a5d6a7;
    }

    .turn-banner.waiting {
        background: #fff8e1;
        color: #ef6c00;
        border: 1px solid #ffe0b2;
    }

    .turn-banner-text {
        display: inline-flex;
        align-items: center;
    }

    .dot-pulse {
        display: inline-block;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: #ff9800;
        animation: solver-pulse 1.4s ease-in-out infinite;
    }

    /* Solver status indicator */
    .solver-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 3px 10px;
        border-radius: 12px;
        font-size: 0.78rem;
        font-weight: 500;
        transition: all 0.2s ease;
    }

    .solver-status.computing {
        background: #fff3e0;
        color: #e65100;
        border: 1px solid #ffcc80;
    }

    .solver-status.ready {
        background: #e8f5e9;
        color: #2e7d32;
        border: 1px solid #a5d6a7;
    }

    .solver-status svg {
        flex-shrink: 0;
    }

    .solver-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background-color: #ff9800;
        animation: solver-pulse 1.2s ease-in-out infinite;
    }

    @@keyframes solver-pulse {
        0%, 100% { opacity: 0.4; transform: scale(0.85); }
        50% { opacity: 1; transform: scale(1.1); }
    }

    /* Board */
    .solution-section {
        padding: 20px;
        border: 2px solid #e0e0e0;
        border-radius: 10px;
        background-color: #f7f7f7;
        text-align: center;
        min-height: 218px;
    }

    /* Error */
    .error-message {
        background: linear-gradient(135deg, #ffebee, #ffcdd2);
        border: 2px solid #f44336;
        border-radius: 10px;
        padding: 15px;
        margin: 15px 0;
        display: flex;
        align-items: center;
        gap: 10px;
        color: #c62828;
        font-weight: 600;
        box-shadow: 0 4px 12px rgba(244, 67, 54, 0.2);
        animation: shake 0.5s ease-in-out;
    }

    .error-message svg {
        flex-shrink: 0;
        stroke: #c62828;
    }

    .error-message span {
        flex: 1;
        text-align: left;
    }

    @@keyframes shake {
        0%, 100% {
            transform: translateX(0);
        }
        10%, 30%, 50%, 70%, 90% {
            transform: translateX(-5px);
        }
        20%, 40%, 60%, 80% {
            transform: translateX(5px);
        }
    }

    /* Optimal play hint */
    .optimal-play-section {
        background: linear-gradient(135deg, #e3f2fd, #f3e5f5);
        border: 2px solid #64b5f6;
        border-radius: 10px;
        padding: 15px 20px;
        margin: 15px 0;
        box-shadow: 0 4px 12px rgba(33, 150, 243, 0.15);
    }

    .optimal-play-section h4 {
        margin: 0 0 12px 0;
        color: #1565c0;
        font-size: 1rem;
        font-weight: 600;
    }

    .optimal-play-tiles {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        align-items: center;
    }

    /* My rack section */
    .my-rack-section {
        position: sticky;
        bottom: 12px;
        z-index: 50;
        background: linear-gradient(135deg, #f5f5f5, #fafafa);
        border: 2px solid #e0e0e0;
        border-radius: 15px;
        padding: 16px 20px;
        margin: 20px 0 0 0;
        text-align: center;
        box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.08);
    }

    .my-rack-section.active-turn {
        background: linear-gradient(135deg, #e3f2fd, #f3e5f5);
        border: 2px solid #2196f3;
        box-shadow: 0 -4px 20px rgba(33, 150, 243, 0.2);
    }

    .rack-title {
        color: #1976d2;
        margin: 0 0 10px 0;
        font-size: 1.05rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .keyboard-hint {
        font-size: 0.72rem;
        color: #888;
        font-weight: 400;
