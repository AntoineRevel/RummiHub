@page "/game/{GameId}"
@using RummiHub.Web.Models
@using RummiHub.Web.Components.Layout
@using RummiHub.Web.Services
@layout GameLayout
@rendermode InteractiveServer
@implements IAsyncDisposable

<PageTitle>Rummikub - @(GameId ?? "Game")</PageTitle>

@if (!_isConnected)
{
    <div class="game-container">
        <div class="loading-state">
            @if (string.IsNullOrEmpty(_error))
            {
                <div class="spinner"></div>
                <p>Connecting to game...</p>
            }
        </div>
    </div>
}
else if (_gameState == null)
{
    <div class="game-container">
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading game...</p>
        </div>
    </div>
}
else
{
    <!-- Three bands: a one-line top bar, the table (takes every spare pixel), and the hand
         dock stuck to the bottom. The page scrolls only when the table outgrows the screen;
         the top bar and the dock stay put, so nothing clips a tile in flight. -->
    <div class="game-container @(IsMyTurn ? "is-my-turn" : "")" tabindex="0" @onkeydown="OnKeyDown">
        <header class="game-topbar">
            <span class="meta-chip turn-chip" title="Current turn">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="23 4 23 10 17 10"/>
                    <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/>
                </svg>
                <span class="chip-label">Turn</span> @_gameState.Turn
            </span>
            <!-- A drawn tile flies into the rack out of this chip. -->
            <span class="meta-chip pool-chip" title="Tiles left in pool" data-anim-origin="pool">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
                </svg>
                @_gameState.TilePoolCount <span class="chip-label">in pool</span>
            </span>

            <!-- Players, as pills on the same line (they wrap under it on a phone). -->
            <div class="players-bar">
                @foreach (var (player, index) in _gameState.Players.Select((p, i) => (p, i)))
                {
                    var isCurrent = index == _gameState.CurrentPlayerIndex && !_gameState.IsGameOver;
                    var isMe = player.Name == PlayerName;
                    <!-- The tiles a player lays fly onto the board out of their chip — unless they
                         come from my own play zone. -->
                    <div class="player-chip @(isCurrent ? "current" : "") @(isMe ? "me" : "")"
                         data-anim-origin="@(isCurrent ? "mover" : null)"
                         title="@player.Name · @player.TileCount tiles">
                        @if (isCurrent)
                        {
                            <span class="active-pulse" aria-hidden="true"></span>
                        }
                        <span class="player-name">
                            @player.Name
                            @if (isMe)
                            {
                                <small>(you)</small>
                            }
                        </span>
                        <span class="tile-count">@player.TileCount</span>
                    </div>
                }
            </div>

            @* The game's seed, shortened (full value in the title, and Copy). Save seed adds it
               to the lobby list at any time. *@
            <span class="meta-chip seed-chip" title="@SeedChipTitle">
                <span class="chip-label">Seed</span>
                @if (_gameState.DistributionSeed is { } seed)
                {
                    <span class="seed-abbr" title="@seed">@DistributionSeeds.Abbreviate(seed)</span>
                    <button type="button" class="seed-copy" title="@seed" @onclick="OnCopySeed">
                        @(_seedCopied ? "Copied" : "Copy")
                    </button>
                }
                <button type="button"
                        class="seed-replay-btn @(SeedSaved ? "saved" : "")"
                        title="Add this game's seed to the lobby list to replay the same deal"
                        disabled="@SeedSaved"
                        @onclick="OnSaveSeed">
                    @if (SeedSaved)
                    {
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <polyline points="20 6 9 17 4 12"/>
                        </svg>
                        <span>Seed saved</span>
                    }
                    else
                    {
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="12" y1="5" x2="12" y2="19"/>
                            <line x1="5" y1="12" x2="19" y2="12"/>
                        </svg>
                        <span>Save seed</span>
                    }
                </button>
            </span>
            <div class="game-id" title="Game code">#@_gameState.GameId</div>
        </header>

        @if (_gameState.IsGameOver)
        {
            <div class="game-over">
                <span class="trophy" aria-hidden="true">🏆</span>
                <h2>@_gameState.WinnerName won the game!</h2>
                <div class="game-over-actions">
                    <button @onclick="OnReplayAnimation" class="btn-replay" disabled="@(!_canReplay || _isLoading)"
                            title="Replay the winning move">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2">
                            <polyline points="1 4 1 10 7 10"/>
                            <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/>
                        </svg>
                        <span>Replay</span>
                    </button>
                    <button class="btn-back-lobby" @onclick="@(() => Navigation.NavigateTo("/lobby"))">
                        Back to lobby
                    </button>
                </div>
            </div>
        }
        else
        {
            <!-- Turn status: one thin line. -->
            <div class="turn-banner @(IsMyTurn ? "my-turn" : "waiting")">
                @if (AwaitingMyConfirmation)
                {
                    <span class="turn-banner-text">Move played — replay it, then pass the turn.</span>
                }
                else if (_gameState.AwaitingConfirmation)
                {
                    <span class="dot-pulse" aria-hidden="true"></span>
                    <span class="turn-banner-text">@CurrentPlayerName is reviewing their move…</span>
                }
                else if (IsMyTurn)
                {
                    <span class="turn-banner-text">Your turn — pick tiles to play, or draw.</span>
                }
                else
                {
                    <span class="dot-pulse" aria-hidden="true"></span>
                    <span class="turn-banner-text">Waiting for @CurrentPlayerName…</span>
                }
                @* Review mode already offers this next to "Next player". Everywhere else —
                   while an AI plays, and once that move has landed — the last board story
                   stays replayable from here. *@
                @if (!AwaitingMyConfirmation)
                {
                    <button @onclick="OnReplayAnimation" class="btn-replay btn-replay-inline"
                            disabled="@(!_canReplay || _isLoading)" title="Replay the last move">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2">
                            <polyline points="1 4 1 10 7 10"/>
                            <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/>
                        </svg>
                        <span>Replay</span>
                    </button>
                }
            </div>
        }

        <!-- Board. Staged: each change plays as lift → make room → place, so a tile at rest
             never covers another. -->
        <div class="solution-section" data-anim-scope="board" data-anim-staged data-anim-enter-from="mover">
            <SolutionComponent Solution="_gameState.Board" HighlightIndices="_highlightIndices"
                              ModifiedSetIndices="_modifiedSetIndices"/>
        </div>

        <!-- Error play -->
        @if (!string.IsNullOrEmpty(_errorPlay))
        {
            <div class="error-message">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"/>
                    <line x1="12" y1="8" x2="12" y2="12"/>
                    <line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
                <span>@_errorPlay</span>
            </div>
        }

        <!-- Hand dock: stuck to the bottom. Top to bottom: play zone (only while something
             is selected), one toolbar line, the rack, the action row. The dock grows UPWARD,
             so the rack and the buttons never move when the play zone appears: the table
             above gives the room. -->
        @if (_rackTiles.Count > 0 && !_gameState.IsGameOver)
        {
            <div class="hand-dock @(IsMyTurn ? "active-turn" : "")">
                <!-- Play zone: shows only the current selection. Hint fills that selection on
                     demand; nothing is suggested until then. A tile picked here flies back to
                     its stack. -->
                @if (IsMyTurn && SelectedTilesForPlay.Any())
                {
                    <div class="play-zone">
                        <div class="play-zone-label">To play · @SelectedTilesForPlay.Count</div>
                        <div class="selected-tiles-display" data-anim-scope="selection">
                            @* Keyed by copy: removing a tile drops its own wrapper instead of
                               shifting every later tile's content into its neighbour's. *@
                            @foreach (var (tile, copy) in SelectedTilesWithCopy())
                            {
                                <div class="selected-tile-wrapper" @key="(tile, copy)"
                                     @onclick="() => OnSelectedTileClick(tile)">
                                    <TileComponent Tile="tile" ShouldHighlight="false"/>
                                </div>
                            }
                        </div>
                    </div>
                }

                <div class="rack-toolbar">
                    <span class="rack-count">Your tiles</span>
                    <div class="rack-sort" role="group" aria-label="Sort tiles by">
                        <span class="rack-sort-label">Sort</span>
                        <button type="button" class="rack-sort-btn @(_rackSort == RackSort.Color ? "active" : "")"
                                aria-pressed="@(_rackSort == RackSort.Color)"
                                @onclick="() => SetRackSortAsync(RackSort.Color)">Color</button>
                        <button type="button" class="rack-sort-btn @(_rackSort == RackSort.Value ? "active" : "")"
                                aria-pressed="@(_rackSort == RackSort.Value)"
                                @onclick="() => SetRackSortAsync(RackSort.Value)">Value</button>
                    </div>
                    @if (CanAct)
                    {
                        <button type="button" class="btn-hint @(_hintNoMove ? "no-move" : "")" @onclick="RequestHint"
                                disabled="@(HintPending || _hintNoMove || _isLoading)"
                                title="@(_hintNoMove ? "Nothing to play — draw a tile." : "Select the best tiles to play")">
                            @if (HintPending)
                            {
                                <span class="solver-dot"></span>
                                <span>Computing…</span>
                            }
                            else
                            {
                                <span>Hint</span>
                            }
                        </button>
                    }
                    @if (ShowDrawHint)
                    {
                        <span class="draw-hint">Nothing to play — draw a tile.</span>
                    }
                    @if (AwaitingMyConfirmation)
                    {
                        <span class="keyboard-hint">
                            <kbd>Enter</kbd> next player
                        </span>
                    }
                    else if (IsMyTurn)
                    {
                        <span class="keyboard-hint">
                            <kbd>Enter</kbd> play · <kbd>Esc</kbd> clear
                        </span>
                    }
                </div>

                <!-- One rack for both states (readonly out of turn): keeping the same DOM
                     subtree across turn flips lets a draw's flight survive the re-render.
                     Enter-only scope: a drawn tile flies in from the pool and deselections
                     fly home, but internal reshuffles display instantly. -->
                <div class="tiles-container @(CanAct ? "" : "readonly")"
                     data-anim-scope="rack" data-anim-enter-only data-anim-enter-from="pool">
                    @foreach (var tileGroup in GetGroupedTiles())
                    {
                        var tileType = tileGroup.Key;
                        var totalCount = tileGroup.Count();
                        var selectedCount = GetSelectedCountForTile(tileType);
                        var remainingCount = totalCount - selectedCount;
                        var isFullySelected = remainingCount == 0;

                        <div class="tile-stack @(isFullySelected ? "fully-selected" : "")"
                             @onclick="() => OnTileStackClick(tileType)">
                            @if (remainingCount > 0)
                            {
                                for (var i = 0; i < remainingCount; i++)
                                {
                                    var stackOffset = i * 3;
                                    <!-- The tile I just drew stays lit on top of its stack. -->
                                    <div class="stacked-tile"
                                         style="z-index: @(100 - i); transform: translate(@(stackOffset)px, @(-stackOffset)px);">
                                        <TileComponent Tile="tileType" ShouldHighlight="@(i == 0 && tileType.Equals(_drawnTile))"/>
                                    </div>
                                }
                                @if (remainingCount > 1)
                                {
                                    <div class="count-indicator">@remainingCount</div>
                                }
                            }
                            else
                            {
                                <!-- Not measured for animation, so selecting the last copy
                                     flies to the selection instead of popping there. -->
                                <div class="stacked-tile greyed-out" data-anim-ignore>
                                    <TileComponent Tile="tileType" ShouldHighlight="false"/>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Action buttons: always one row of the same height (Draw disabled out of
                     turn), so the dock never jumps between turns. -->
                <div class="human-actions-buttons">
                    @if (AwaitingMyConfirmation)
                    {
                        <button @onclick="OnReplayAnimation" class="btn-replay" disabled="@(!_canReplay || _isLoading)"
                                title="Replay the move">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2">
                                <polyline points="1 4 1 10 7 10"/>
                                <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/>
                            </svg>
                            <span class="btn-label">Replay</span>
                        </button>
                        <button @onclick="OnConfirmEndTurn" class="btn-play" disabled="@_isLoading">
                            @if (_isLoading)
                            {
                                <span class="spinner"></span>
                                <span>Passing…</span>
                            }
                            else
                            {
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="2">
                                    <polyline points="9 6 15 12 9 18"/>
                                </svg>
                                <span>Next player</span>
                            }
                        </button>
                    }
                    else if (SelectedTilesForPlay.Any())
                    {
                        <button @onclick="OnClearSelection" class="btn-clear" disabled="@_isLoading" title="Clear selection">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2">
                                <path d="M18 6L6 18M6 6l12 12"/>
                            </svg>
                            <span class="btn-label">Clear</span>
                        </button>
                        <button @onclick="() => OnPlaySelection(autoContinue: false)" class="btn-play-review"
                                disabled="@_isLoading"
                                title="Play, watch the animation, then pass the turn yourself">
                            @if (_isLoading && !_loadingAutoContinue)
                            {
                                <span class="spinner"></span>
                                <span>Validating...</span>
                            }
                            else
                            {
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="2">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                    <circle cx="12" cy="12" r="3"/>
                                </svg>
                                <span class="lbl-full">Play &amp; review</span><span class="lbl-short">Review</span>
                            }
                        </button>
                        <button @onclick="() => OnPlaySelection(autoContinue: true)" class="btn-play"
                                disabled="@_isLoading"
                                title="Play and let the game continue automatically">
                            @if (_isLoading && _loadingAutoContinue)
                            {
                                <span class="spinner"></span>
                                <span>Validating...</span>
                            }
                            else
                            {
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="2">
                                    <circle cx="12" cy="12" r="10"/>
                                    <polygon points="10,8 16,12 10,16 10,8"/>
                                </svg>
                                <span class="lbl-full">Play &amp; continue</span><span class="lbl-short">Play</span>
                            }
                        </button>
                    }
                    else
                    {
                        <button @onclick="OnDrawTile" class="btn-draw" title="Draw a tile from the pool"
                                disabled="@(!IsMyTurn || _isLoading || _gameState.TilePoolCount == 0)">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2">
                                <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
                            </svg>
                            <span>Draw</span>
                        </button>
                    }
                </div>
            </div>
        }
    </div>
}

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger mt-3">@_error</div>
}

<style>
    /* Layout: a flat page, no card. It fills the layout's screen-tall column so the dock
       sits at the bottom even over an empty table; a crowded table makes the page scroll
       while the top bar and the dock stay stuck. */
    .game-container {
        display: flex;
        flex-direction: column;
        flex: 1 1 auto;
        font-family: Arial, sans-serif;
        background: #fff;
        outline: none;
        box-sizing: border-box;
    }

    .game-container:has(.loading-state) {
        justify-content: center;
    }

    /* Top bar: one line on desktop. Players wrap under it on a phone. */
    .game-topbar {
        position: sticky;
        top: 0;
        z-index: 40;
        display: flex;
        align-items: center;
        gap: 6px 8px;
        flex-wrap: wrap;
        padding: 6px 10px;
        background: rgba(255, 255, 255, 0.96);
        backdrop-filter: blur(6px);
        border-bottom: 1px solid #eee;
    }

    .meta-chip {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 0 9px;
        height: 30px;
        font-size: 0.8rem;
        color: #555;
        background: #f4f6f8;
        border: 1px solid #e2e6ea;
        border-radius: 999px;
        line-height: 1;
        white-space: nowrap;
        flex-shrink: 0;
    }

    .meta-chip svg {
        flex-shrink: 0;
        opacity: 0.75;
    }

    .turn-chip {
        color: #1565c0;
        background: #e3f2fd;
        border-color: #bbdefb;
        font-weight: 600;
    }

    .pool-chip {
        color: #6a1b9a;
        background: #f3e5f5;
        border-color: #e1bee7;
    }

    .seed-chip {
        position: relative;
    }

    .seed-chip .seed-abbr {
        font-family: monospace;
        font-weight: 700;
        color: #555;
        max-width: 9rem;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .seed-chip .seed-copy {
        padding: 2px 8px;
        border: 1px solid #c5d0da;
        border-radius: 999px;
        background: #fff;
        color: #1565c0;
        font-size: 0.72rem;
        font-weight: 600;
        cursor: pointer;
    }

    /* Always shown: a phone has no hover to reveal it. */
    .seed-replay-btn {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 9px;
        border: none;
        border-radius: 999px;
        background: linear-gradient(135deg, #4caf50, #388e3c);
        color: #fff;
        font-size: 0.72rem;
        font-weight: 600;
        line-height: 1;
        cursor: pointer;
        white-space: nowrap;
    }

    .seed-replay-btn:hover {
        background: linear-gradient(135deg, #388e3c, #2e7d32);
    }

    .seed-replay-btn:disabled,
    .seed-replay-btn.saved {
        cursor: default;
        background: linear-gradient(135deg, #66bb6a, #43a047);
    }

    .seed-replay-btn svg {
        flex-shrink: 0;
    }

    .game-id {
        margin-left: auto;
        font-family: monospace;
        font-size: 0.78rem;
        color: #999;
        letter-spacing: 0.02em;
        user-select: all;
    }

    /* Loading */
    .loading-state {
        text-align: center;
        padding: 60px 20px;
    }

    .loading-state p {
        margin-top: 15px;
        color: #777;
        font-size: 1.1rem;
    }

    /* Players: pills in the top bar */
    .players-bar {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
        align-items: center;
    }

    .player-chip {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        height: 30px;
        padding: 0 4px 0 10px;
        background: #fff;
        border: 1px solid #e0e0e0;
        border-radius: 999px;
        transition: background 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
        max-width: 190px;
    }

    .player-chip.current {
        background: linear-gradient(135deg, #e8f5e9, #f1f8f4);
        border-color: #4caf50;
        box-shadow: 0 2px 6px rgba(76, 175, 80, 0.2);
    }

    .active-pulse {
        position: absolute;
        top: -3px;
        left: -3px;
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: #4caf50;
        box-shadow: 0 0 0 0 rgba(76, 175, 80, 0.6);
        animation: active-ring 1.6s ease-out infinite;
    }

    @@keyframes active-ring {
        0% { box-shadow: 0 0 0 0 rgba(76, 175, 80, 0.6); }
        70% { box-shadow: 0 0 0 8px rgba(76, 175, 80, 0); }
        100% { box-shadow: 0 0 0 0 rgba(76, 175, 80, 0); }
    }

    .player-chip.me {
        border-color: #2196f3;
    }

    .player-chip.me.current {
        border-color: #4caf50;
        background: linear-gradient(135deg, #e3f2fd, #e8f5e9);
    }

    .player-chip .player-name {
        font-weight: 600;
        color: #333;
        font-size: 0.85rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .player-chip .player-name small {
        font-weight: 400;
        color: #999;
        font-size: 0.72rem;
    }

    .player-chip .tile-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 22px;
        height: 22px;
        padding: 0 6px;
        background: linear-gradient(135deg, #e3f2fd, #bbdefb);
        color: #1565c0;
        font-weight: 700;
        font-size: 0.8rem;
        border-radius: 999px;
    }

    .player-chip.current .tile-count {
        background: linear-gradient(135deg, #c8e6c9, #a5d6a7);
        color: #2e7d32;
    }

    /* Game over: one line above the table */
    .game-over {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px 16px;
        flex-wrap: wrap;
        background: linear-gradient(135deg, #f1f8e9, #fff8e1);
        border-bottom: 1px solid #c5e1a5;
        padding: 10px 16px;
    }

    .game-over .trophy {
        font-size: 1.6rem;
        line-height: 1;
        animation: trophy-bounce 1.6s ease-in-out infinite;
    }

    @@keyframes trophy-bounce {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-5px); }
    }

    .game-over h2 {
        color: #4caf50;
        font-size: 1.15rem;
        margin: 0;
    }

    .game-over-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .game-over .btn-replay {
        flex: none;
        min-width: 0;
    }

    .btn-back-lobby {
        padding: 8px 16px;
        font-size: 0.9rem;
        font-weight: 600;
        color: #fff;
        background: linear-gradient(135deg, #2196f3, #1976d2);
        border: none;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.2s ease;
        box-shadow: 0 3px 10px rgba(33, 150, 243, 0.3);
    }

    .btn-back-lobby:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(33, 150, 243, 0.4);
    }

    /* Turn banner: a thin strip */
    .turn-banner {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px 12px;
        flex-wrap: wrap;
        padding: 4px 12px;
        min-height: 32px;
