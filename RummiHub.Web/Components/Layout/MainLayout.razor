@inherits LayoutComponentBase

@* Player pages (the lobby at /, the error page) and the developer bench fill the
   viewport. The game table uses GameLayout, which has no content padding. *@
<div class="page">
    <main>
        <article class="content">
            @Body
        </article>
    </main>
</div>

<TestSiteBadge/>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
