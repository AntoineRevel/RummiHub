@inherits LayoutComponentBase

<div class="page">
    <input type="checkbox" id="sidebar-collapse" class="sidebar-collapse-input" hidden/>
    <aside class="sidebar">
        <NavMenu/>
        <label for="sidebar-collapse" class="sidebar-collapse-btn" title="Toggle menu" aria-label="Toggle menu">
            <svg class="icon-collapse" width="18" height="18" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"/>
            </svg>
        </label>
    </aside>

    <main>
        <article class="content">
            @Body
        </article>
    </main>
</div>

<TestSiteBadge/>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

