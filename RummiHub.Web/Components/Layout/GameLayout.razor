@inherits LayoutComponentBase

@* The game page fills the viewport, with no content padding. The table's own top bar
   carries the way back to the lobby. *@
<main class="game-main">
    <TestSiteBadge Inline="true"/>
    @Body
</main>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss" role="button" aria-label="Dismiss" title="Dismiss">×</a>
</div>
