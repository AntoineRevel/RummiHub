{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "mcp__aspire__list_resources",
      "mcp__aspire__list_console_logs",
      "mcp__aspire__list_structured_logs",
      "mcp__aspire__list_traces",
      "mcp__aspire__list_trace_structured_logs",
      "mcp__aspire__execute_resource_command",
      "mcp__aspire__list_apphosts",
      "mcp__aspire__select_apphost",
      "mcp__aspire__list_integrations",
      "mcp__aspire__doctor",
      "mcp__aspire__get_doc",
      "mcp__aspire__list_docs",
      "mcp__aspire__search_docs",
      "mcp__aspire__refresh_tools",
      "Skill(update-config)",
      "Skill(update-config:*)",
      "Bash(dotnet build *)",
      "Bash(dotnet test *)",
      "Bash(git checkout *)",
      "Bash(git add *)",
      "Bash(git commit -m ' *)",
      "Bash(git push *)",
      "Bash(gh pr create --base master --head priority-solve-validation --title 'Prioritize move validation in the solve pipeline' --body ' *)",
      "Bash(echo \"gh-exit:$?\")",
      "Bash(env)",
      "Bash(apt-cache policy *)",
      "Bash(python3 -c \"import sys; print\\(sys.path[:3]\\)\")",
      "Bash(python3 -I -c \"import json; print\\('json ok', json.__file__\\)\")",
      "Bash(jq --version)",
      "Bash(xargs cat)",
      "Bash(dmesg)",
      "Read(//sys/fs/cgroup/**)",
      "Bash(ps -eo pid,ppid,lstart,etime,rss,comm,args --sort=lstart)",
      "Bash(ps -o pid,lstart,etime,args -p 32060,31814)",
      "Read(//home/vscode/.aspire/logs/**)",
      "Read(//home/vscode/.cache/dcp-work/**)",
      "Bash(awk '$6 >= \"18:33:00\" && $6 <= \"18:37:00\"')",
      "Bash(git rm *)",
      "Bash(git ls-tree *)",
      "Bash(gh pr create --base master --head claude/awesome-carson-0g6yba --title 'Add AI auto-play and unify game setup into the lobby' --body ' *)",
      "Bash(python3 -c \"import sys; print\\(sys.version\\); print\\(sys.executable\\)\")",
      "Bash(ps -eo pid,lstart,args)",
      "Bash(chmod +x /tmp/worker-sig-watcher.sh)",
      "Bash(nohup /tmp/worker-sig-watcher.sh)",
      "Bash(echo \"watcher PID: $!\")",
      "Bash(sudo cat /proc/77888/status)",
      "Bash(git -C /workspaces/RummiHub diff --stat RummiHub.Solver.Worker/SolverWorker.cs)",
      "Bash(node --check --input-type=module -)",
      "Read(//usr/local/share/nvm/versions/**)",
      "Read(//home/vscode/.nvm/versions/**)",
      "Bash(git -C /workspaces/RummiHub diff master --stat)",
      "Bash(npx playwright *)",
      "Bash(python3 -c \"import playwright; print\\('py-playwright ok'\\)\")",
      "Read(//home/vscode/.cache/**)",
      "Bash(pip list *)",
      "Bash(dotnet tool *)",
      "Read(//tmp/claude-1000/-workspaces-RummiHub/**)",
      "Bash(pip install *)",
      "Bash(python3 -m playwright install chromium --with-deps)",
      "Bash(python3 -m pip --version)",
      "Bash(apt list *)",
      "Bash(sudo apt-get update -qq)",
      "Bash(sudo apt-get install -y -qq python3-pip chromium-browser)",
      "Bash(chromium-browser --version)",
      "Bash(python3 -m pip install --break-system-packages -q playwright)",
      "Bash(python3 -m playwright install --with-deps chromium)",
      "Bash(aspire run *)",
      "Bash(python3 verify_review.py)",
      "Edit(/.claude/skills/verify/**)",
      "Bash(chmod +x /workspaces/RummiHub/.devcontainer/install-ui-testing.sh)",
      "Bash(bash /workspaces/RummiHub/.devcontainer/install-ui-testing.sh)",
      "Bash(python3 -c \"import json; json.load\\(open\\('/workspaces/RummiHub/.devcontainer/devcontainer.json'\\)\\); print\\('json OK'\\)\")",
      "Bash(python3 -)"
    ],
    "additionalDirectories": [
      "/tmp"
    ]
  }
}
